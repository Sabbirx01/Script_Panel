<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ==================================================================
         PALETTE
    =================================================================== -->
    <Color x:Key="C.AppBg1">#FF05080E</Color>
    <Color x:Key="C.AppBg2">#FF0D1526</Color>
    <Color x:Key="C.TitleBar">#FF070B13</Color>
    <Color x:Key="C.Card">#FF101828</Color>
    <Color x:Key="C.CardSoft">#FF141E33</Color>
    <Color x:Key="C.Field">#FF0B1220</Color>
    <Color x:Key="C.Line">#FF1E2A44</Color>
    <Color x:Key="C.LineStrong">#FF2E3D5E</Color>
    <Color x:Key="C.Text">#FFE9EEF9</Color>
    <Color x:Key="C.TextDim">#FF93A3C2</Color>
    <Color x:Key="C.TextMuted">#FF5E6D8B</Color>
    <Color x:Key="C.AccentA">#FF22D3EE</Color>
    <Color x:Key="C.AccentB">#FF8B5CF6</Color>
    <Color x:Key="C.Ok">#FF34D399</Color>
    <Color x:Key="C.Warn">#FFFBBF24</Color>
    <Color x:Key="C.Err">#FFF87171</Color>

    <!-- ==================================================================
         BRUSHES
    =================================================================== -->
    <SolidColorBrush x:Key="B.Text" Color="{StaticResource C.Text}" />
    <SolidColorBrush x:Key="B.TitleBar" Color="{StaticResource C.TitleBar}" />
    <SolidColorBrush x:Key="B.TextDim" Color="{StaticResource C.TextDim}" />
    <SolidColorBrush x:Key="B.TextMuted" Color="{StaticResource C.TextMuted}" />
    <SolidColorBrush x:Key="B.Line" Color="{StaticResource C.Line}" />
    <SolidColorBrush x:Key="B.LineStrong" Color="{StaticResource C.LineStrong}" />
    <SolidColorBrush x:Key="B.Card" Color="{StaticResource C.Card}" />
    <SolidColorBrush x:Key="B.CardSoft" Color="{StaticResource C.CardSoft}" />
    <SolidColorBrush x:Key="B.Field" Color="{StaticResource C.Field}" />
    <SolidColorBrush x:Key="B.Ok" Color="{StaticResource C.Ok}" />
    <SolidColorBrush x:Key="B.Warn" Color="{StaticResource C.Warn}" />
    <SolidColorBrush x:Key="B.Err" Color="{StaticResource C.Err}" />
    <SolidColorBrush x:Key="B.AccentA" Color="{StaticResource C.AccentA}" />
    <SolidColorBrush x:Key="B.AccentB" Color="{StaticResource C.AccentB}" />

    <LinearGradientBrush x:Key="B.AppBg" StartPoint="0,0" EndPoint="0.55,1">
        <GradientStop Color="{StaticResource C.AppBg1}" Offset="0" />
        <GradientStop Color="{StaticResource C.AppBg2}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="B.Accent" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource C.AccentA}" Offset="0" />
        <GradientStop Color="{StaticResource C.AccentB}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="B.AccentHover" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF4BE0F5" Offset="0" />
        <GradientStop Color="#FFA279F8" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="B.CardSheen" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF14203A" Offset="0" />
        <GradientStop Color="#FF0E1626" Offset="1" />
    </LinearGradientBrush>

    <!-- Neutral control surface -->
    <SolidColorBrush x:Key="B.ControlOff" Color="#FF1A2336" />

    <FontFamily x:Key="F.Ui">Segoe UI</FontFamily>
    <FontFamily x:Key="F.Mono">Consolas</FontFamily>

    <!-- ==================================================================
         SCROLLBAR (slim, dark)
    =================================================================== -->
    <Style x:Key="S.Thumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="bd" CornerRadius="5" Margin="3,2" Background="#FF2A3652" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#FF44557D" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource S.Thumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="12" />
                <Setter Property="Width" Value="Auto" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ==================================================================
         TEXT ELEMENTS
    =================================================================== -->
    <Style x:Key="T.Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Semibold" />
        <Setter Property="FontSize" Value="27" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style x:Key="T.Sub" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Foreground" Value="{StaticResource B.TextDim}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="T.Label" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource B.TextDim}" />
        <Setter Property="Margin" Value="2,0,0,6" />
    </Style>

    <Style x:Key="T.CardTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Semibold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
    </Style>

    <Style x:Key="T.Hint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{StaticResource B.TextMuted}" />
    </Style>

    <!-- ==================================================================
         TEXTBOX
    =================================================================== -->
    <Style x:Key="S.TextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource B.Field}" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="CaretBrush" Value="{StaticResource B.AccentA}" />
        <Setter Property="SelectionBrush" Value="#FF1D5C6E" />
        <Setter Property="BorderBrush" Value="{StaticResource B.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="13,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="bd"
                            CornerRadius="10"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource B.LineStrong}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource B.AccentA}" />
                            <Setter TargetName="bd" Property="Background" Value="#FF0E1A2E" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource B.TextMuted}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================================================================
         PASSWORDBOX
    =================================================================== -->
    <Style x:Key="S.PasswordBox" TargetType="PasswordBox">
        <Setter Property="Background" Value="{StaticResource B.Field}" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="CaretBrush" Value="{StaticResource B.AccentA}" />
        <Setter Property="SelectionBrush" Value="#FF1D5C6E" />
        <Setter Property="BorderBrush" Value="{StaticResource B.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="13,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="PasswordChar" Value="●" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="bd"
                            CornerRadius="10"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource B.LineStrong}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource B.AccentA}" />
                            <Setter TargetName="bd" Property="Background" Value="#FF0E1A2E" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================================================================
         BUTTONS
    =================================================================== -->
    <Style x:Key="S.PrimaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="#FF06131C" />
        <Setter Property="Background" Value="{StaticResource B.Accent}" />
        <Setter Property="FontFamily" Value="Segoe UI Semibold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Height" Value="48" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="bd" CornerRadius="12" Background="{TemplateBinding Background}">
                            <Border.Effect>
                                <DropShadowEffect Color="#FF22D3EE" BlurRadius="26" ShadowDepth="0" Opacity="0.38" />
                            </Border.Effect>
                        </Border>
                        <!-- lightens whatever background colour the caller supplied -->
                        <Border x:Name="sheen" CornerRadius="12" Background="#FFFFFFFF"
                                Opacity="0" IsHitTestVisible="False" />
                        <ContentPresenter Margin="20,0"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="sheen" Property="Opacity" Value="0.15" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="sheen" Property="Opacity" Value="0.02" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource B.ControlOff}" />
                            <Setter TargetName="bd" Property="Effect" Value="{x:Null}" />
                            <Setter Property="Foreground" Value="{StaticResource B.TextMuted}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="S.GhostButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="FontFamily" Value="Segoe UI Semibold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd"
                            CornerRadius="10"
                            Background="#FF131C2F"
                            BorderBrush="{StaticResource B.Line}"
                            BorderThickness="1">
                        <ContentPresenter Margin="14,0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#FF1B2740" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource B.LineStrong}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.75" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="S.MiniButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource B.AccentA}" />
        <Setter Property="FontFamily" Value="Segoe UI Semibold" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd"
                            CornerRadius="10"
                            Background="#FF0F1B2E"
                            BorderBrush="#FF27405C"
                            BorderThickness="1">
                        <ContentPresenter Margin="14,0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#FF152840" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource B.AccentA}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource B.TextMuted}" />
                            <Setter TargetName="bd" Property="Background" Value="#FF121A29" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Window chrome buttons -->
    <Style x:Key="S.ChromeButton" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#FFA6B4CE" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="8" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#FF1B2436" />
                            <Setter Property="Foreground" Value="#FFFFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#FF232E45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="S.ChromeCloseButton" TargetType="Button" BasedOn="{StaticResource S.ChromeButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="8" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#FFE11D48" />
                            <Setter Property="Foreground" Value="#FFFFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#FFBE123C" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================================================================
         CARDS
    =================================================================== -->
    <Style x:Key="S.Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource B.Card}" />
        <Setter Property="BorderBrush" Value="{StaticResource B.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="22" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#FF000000" BlurRadius="20" ShadowDepth="5" Direction="270" Opacity="0.34" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Divider rule used under card headings -->
    <Style x:Key="S.Rule" TargetType="Rectangle">
        <Setter Property="Height" Value="1" />
        <Setter Property="Fill" Value="{StaticResource B.Line}" />
        <Setter Property="Margin" Value="0,12,0,16" />
    </Style>

    <!-- Small heading used for "1. CREATE ACCOUNT" style section titles -->
    <Style x:Key="T.Section" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Semibold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
    </Style>

    <!-- Monospace-ish helper line under a field -->
    <Style x:Key="T.Mini" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource B.TextMuted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Compact field used inside tables -->
    <Style x:Key="S.CellBox" TargetType="TextBox" BasedOn="{StaticResource S.TextBox}">
        <Setter Property="Height" Value="36" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontFamily" Value="{StaticResource F.Mono}" />
        <Setter Property="Padding" Value="11,0" />
    </Style>

    <Style x:Key="S.CellPassword" TargetType="PasswordBox" BasedOn="{StaticResource S.PasswordBox}">
        <Setter Property="Height" Value="36" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontFamily" Value="{StaticResource F.Mono}" />
        <Setter Property="Padding" Value="11,0" />
    </Style>

    <!-- ==================================================================
         COMBOBOX
    =================================================================== -->
    <Style x:Key="S.ComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="13,9" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="bd" Background="Transparent"
                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#FF1B2740" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#FF152840" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="S.ComboBox" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource S.ComboBoxItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="toggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                  RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="bd" CornerRadius="10"
                                            Background="{StaticResource B.Field}"
                                            BorderBrush="{StaticResource B.Line}"
                                            BorderThickness="1">
                                        <Path Data="M0,0 L5,5 L10,0"
                                              Stroke="{StaticResource B.TextDim}"
                                              StrokeThickness="1.6"
                                              HorizontalAlignment="Right" VerticalAlignment="Center"
                                              Margin="0,0,15,0" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="BorderBrush"
                                                    Value="{StaticResource B.LineStrong}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <ContentPresenter Margin="13,0,38,0" VerticalAlignment="Center"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />

                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False">
                            <Border Margin="0,4,0,0" CornerRadius="10" Background="#FF101828"
                                    BorderBrush="{StaticResource B.LineStrong}" BorderThickness="1"
                                    MinWidth="{TemplateBinding ActualWidth}" MaxHeight="250">
                                <ScrollViewer>
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================================================================
         CHECKBOX
    =================================================================== -->
    <Style x:Key="S.CheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="box" Width="20" Height="20" CornerRadius="6"
                                Background="{StaticResource B.Field}"
                                BorderBrush="{StaticResource B.LineStrong}" BorderThickness="1"
                                VerticalAlignment="Center">
                            <Path x:Name="tick" Data="M1,5.2 L4.4,8.6 L10,1.6"
                                  Stroke="#FF06131C" StrokeThickness="2.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stretch="Uniform" Margin="4" Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="box" Property="Background" Value="{StaticResource B.AccentA}" />
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource B.AccentA}" />
                            <Setter TargetName="tick" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource B.AccentA}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource B.TextMuted}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================================================================
         RADIOBUTTON
    =================================================================== -->
    <Style x:Key="S.RadioButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="ring" Width="19" Height="19" CornerRadius="10"
                                Background="{StaticResource B.Field}"
                                BorderBrush="{StaticResource B.LineStrong}" BorderThickness="1"
                                VerticalAlignment="Center">
                            <Ellipse x:Name="dot" Width="9" Height="9"
                                     Fill="{StaticResource B.AccentA}" Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="ring" Property="BorderBrush" Value="{StaticResource B.AccentA}" />
                            <Setter TargetName="dot" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ring" Property="BorderBrush" Value="{StaticResource B.AccentA}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource B.TextMuted}" />
                            <Setter TargetName="ring" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
