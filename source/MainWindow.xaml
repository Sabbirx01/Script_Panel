<Window x:Class="AISuitePanel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
         xmlns:core="clr-namespace:AISuitePanel"
         Title="{x:Static core:Branding.WindowTitle}"
        Width="1180" Height="790"
        MinWidth="1000" MinHeight="670"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="{StaticResource B.AppBg}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        StateChanged="OnWindowStateChanged">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="50"
                           ResizeBorderThickness="6"
                           CornerRadius="0"
                           GlassFrameThickness="0"
                           UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
             <RowDefinition Height="50" />
             <RowDefinition Height="*" />
             <RowDefinition Height="30" />
         </Grid.RowDefinitions>

        <!-- ============================ TITLE BAR ============================ -->
        <Grid Grid.Row="0" Background="{StaticResource B.TitleBar}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- brand -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                <Border Width="28" Height="28" CornerRadius="8" Background="{StaticResource B.Accent}">
                    <Path Data="M14.4,2 L5.4,13.6 H11.6 L9.9,22 L18.9,10.4 H12.7 Z"
                          Fill="#FF06131C"
                          Stretch="Uniform"
                          Margin="6" />
                </Border>
                <TextBlock Text="{x:Static core:Branding.AppNameUpper}"
                           Margin="11,0,0,0"
                           VerticalAlignment="Center"
                           FontFamily="Segoe UI Semibold"
                           FontSize="12.5"
                           Foreground="{StaticResource B.Text}" />
                <Border Margin="10,0,0,0" Padding="7,2" CornerRadius="6"
                         Background="#FF141D30" BorderBrush="{StaticResource B.Line}" BorderThickness="1"
                         VerticalAlignment="Center">
                    <TextBlock Text="{x:Static core:Branding.Version}" FontSize="10"
                               Foreground="{StaticResource B.TextMuted}" />
                </Border>
            </StackPanel>

            <!-- status pill + window buttons -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">

                <Border x:Name="StatusPill"
                        CornerRadius="11"
                        Padding="12,5"
                        Margin="0,0,12,0"
                        Background="#22F87171"
                        BorderBrush="#55F87171"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{StaticResource B.Err}"
                                 VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusText"
                                   Text="STATUS: LOCKED"
                                   Margin="8,0,0,0"
                                   FontFamily="Segoe UI Semibold"
                                   FontSize="11"
                                   Foreground="#FFFCA5A5"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Button Style="{StaticResource S.ChromeButton}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="OnMinimize" ToolTip="Minimize">
                    <Path Data="M0,0 H11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.4" />
                </Button>

                <Button x:Name="MaxButton"
                        Style="{StaticResource S.ChromeButton}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="OnMaximize" ToolTip="Maximize">
                    <Path Data="M0.5,0.5 H10.5 V10.5 H0.5 Z"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.4" Fill="Transparent" />
                </Button>

                <Button Style="{StaticResource S.ChromeCloseButton}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="OnClose" ToolTip="Close">
                    <Path Data="M1,1 L10,10 M10,1 L1,10"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.5" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ============================ CONTENT ============================ -->
        <Grid Grid.Row="1" ClipToBounds="True">
            <Ellipse Width="760" Height="760" HorizontalAlignment="Right" VerticalAlignment="Top"
                     Margin="0,-420,-280,0" IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#3A22D3EE" Offset="0" />
                        <GradientStop Color="#0022D3EE" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <Ellipse Width="640" Height="640" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                     Margin="-260,0,0,-330" IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#3A8B5CF6" Offset="0" />
                        <GradientStop Color="#008B5CF6" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <ContentControl x:Name="Host" />
        </Grid>
    </Grid>
</Window>
