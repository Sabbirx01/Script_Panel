<?xml version="1.0" encoding="utf-8"?>
<!--
  Project-local NuGet configuration.
  The machine had no package sources registered globally, which blocked restore
  of the single-file / self-contained runtime packs. Keeping the source here
  means the project builds anywhere without touching the user's global config.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
