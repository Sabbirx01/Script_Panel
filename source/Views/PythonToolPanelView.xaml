<UserControl x:Class="AISuitePanel.Views.PythonToolPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource B.Card}" />
            <Setter Property="BorderBrush" Value="{StaticResource B.Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>

        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontFamily" Value="Segoe UI Semibold" />
            <Setter Property="Foreground" Value="{StaticResource B.TextMuted}" />
        </Style>

        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontFamily" Value="Segoe UI Semibold" />
            <Setter Property="Foreground" Value="{StaticResource B.Text}" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <Style x:Key="TabBtn" TargetType="Button" BasedOn="{StaticResource S.GhostButton}">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>

        <Style x:Key="HeadText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontFamily" Value="Segoe UI Semibold" />
            <Setter Property="Foreground" Value="{StaticResource B.TextMuted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="QtyBox" TargetType="TextBox" BasedOn="{StaticResource S.TextBox}">
            <Setter Property="Width" Value="100" />
            <Setter Property="Height" Value="38" />
            <Setter Property="FontFamily" Value="{StaticResource F.Mono}" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================== BACK ============================== -->
        <Button Grid.Row="0" Content="⬅  BACK TO DASHBOARD"
                Style="{StaticResource S.GhostButton}"
                HorizontalAlignment="Left"
                Margin="34,24,0,0"
                Click="OnBack" />

        <!-- ============================== TITLE ============================== -->
        <StackPanel Grid.Row="1" Margin="34,16,34,0">
            <TextBlock x:Name="TitleText" Style="{StaticResource T.Title}" FontSize="21" />
            <TextBlock x:Name="SubTitle" Style="{StaticResource T.Sub}" FontSize="12.5" Margin="0,8,0,0" />
        </StackPanel>

        <!-- ============================== BODY ============================== -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="34,18,22,26">

                <!-- ============== STAT CARDS ============== -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource StatCard}">
                        <StackPanel>
                            <TextBlock Text="TOTAL ACCOUNTS" Style="{StaticResource StatLabel}" />
                            <TextBlock x:Name="StatTotal" Text="0" Style="{StaticResource StatValue}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource StatCard}">
                        <StackPanel>
                            <TextBlock Text="ACTIVE TODAY" Style="{StaticResource StatLabel}" />
                            <TextBlock x:Name="StatActiveToday" Text="0"
                                       Style="{StaticResource StatValue}"
                                       Foreground="{StaticResource B.Ok}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource StatCard}">
                        <StackPanel>
                            <TextBlock Text="LAST RUN" Style="{StaticResource StatLabel}" />
                            <TextBlock x:Name="StatLastRun" Text="—"
                                       Style="{StaticResource StatValue}"
                                       FontSize="14"
                                       Foreground="{StaticResource B.AccentB}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Style="{StaticResource StatCard}" Margin="0">
                        <StackPanel>
                            <TextBlock Text="SCRIPTS" Style="{StaticResource StatLabel}" />
                            <TextBlock x:Name="StatScripts" Text="—"
                                       Style="{StaticResource StatValue}"
                                       FontSize="14"
                                       Foreground="#FFFBBF24" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ============== TAB BAR ============== -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <Button x:Name="TabDashBtn"   Content="📊 Dashboard"  Style="{StaticResource TabBtn}" Click="OnTabDashboard" />
                    <Button x:Name="TabCreateBtn" Content="▶ Create"      Style="{StaticResource TabBtn}" Click="OnTabCreate" />
                    <Button x:Name="TabLoginBtn"  Content="🔓 Login"       Style="{StaticResource TabBtn}" Click="OnTabLogin" />
                    <Button x:Name="TabExtraBtn"  Content="🎁 Extra"       Style="{StaticResource TabBtn}" Click="OnTabExtra" />
                    <Button x:Name="TabSetBtn"    Content="⚙ Settings"    Style="{StaticResource TabBtn}" Click="OnTabSettings" />
                </StackPanel>

                <!-- ============== TAB: DASHBOARD ============== -->
                <Border x:Name="TabDashboard" Style="{StaticResource S.Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock x:Name="DashboardHeader" Text="ACCOUNT TABLE" Style="{StaticResource T.Section}" />
                        <Rectangle Style="{StaticResource S.Rule}" />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="62" />
                                <ColumnDefinition Width="78" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="#"        Style="{StaticResource HeadText}" />
                            <TextBlock Grid.Column="1" Text="EMAIL"    Style="{StaticResource HeadText}" />
                            <TextBlock Grid.Column="2" Text="SOURCE"   Style="{StaticResource HeadText}" />
                            <TextBlock Grid.Column="3" Text="STATUS"   Style="{StaticResource HeadText}" />
                            <TextBlock Grid.Column="4" Text="COOKIES"  Style="{StaticResource HeadText}" />
                            <TextBlock Grid.Column="5" Text="VIEW"     Style="{StaticResource HeadText}" />
                            <TextBlock Grid.Column="6" Text="EXPORT"   Style="{StaticResource HeadText}" />
                        </Grid>
                        <Rectangle Height="1" Fill="{StaticResource B.Line}" />

                        <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                            <ItemsControl x:Name="AcctList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="62" />
                                                <ColumnDefinition Width="78" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding IdLabel}"
                                                       FontFamily="{StaticResource F.Mono}" FontSize="12"
                                                       Foreground="{StaticResource B.TextDim}"
                                                       VerticalAlignment="Center" />

                                            <TextBlock Grid.Column="1" Text="{Binding EmailUsed}"
                                                       FontFamily="{StaticResource F.Mono}" FontSize="12"
                                                       Foreground="{StaticResource B.Text}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />

                                            <TextBlock Grid.Column="2" Text="{Binding SourceRef}"
                                                       FontSize="11.5"
                                                       Foreground="{StaticResource B.TextDim}"
                                                       VerticalAlignment="Center" />

                                            <TextBlock Grid.Column="3" Text="{Binding StatusLabel}"
                                                       FontSize="11.5" FontFamily="Segoe UI Semibold"
                                                       Foreground="{Binding StatusColor}"
                                                       VerticalAlignment="Center" />

                                            <TextBlock Grid.Column="4" Text="{Binding CookieLabel}"
                                                       FontSize="11.5"
                                                       Foreground="{StaticResource B.TextDim}"
                                                       VerticalAlignment="Center" />

                                            <Button Grid.Column="5" Content="View"
                                                    Style="{StaticResource S.GhostButton}"
                                                    Height="28" FontSize="11"
                                                    Margin="0,0,6,0"
                                                    Click="OnViewCookie" />

                                            <Button Grid.Column="6" Content="Export"
                                                    Style="{StaticResource S.GhostButton}"
                                                    Height="28" FontSize="11"
                                                    Margin="6,0,0,0"
                                                    Click="OnExportCookie" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock x:Name="AcctEmpty" Text="No accounts yet. Run the Create tab to make one, or copy accounts.txt into the script's working folder."
                                   Style="{StaticResource T.Mini}" Margin="2,10,0,0" />
                    </StackPanel>
                </Border>

                <!-- ============== TAB: CREATE ============== -->
                <Border x:Name="TabCreate" Style="{StaticResource S.Card}" Margin="0,0,0,16" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="CREATE ACCOUNT" Style="{StaticResource T.Section}" />
                        <Rectangle Style="{StaticResource S.Rule}" />

                        <!-- Mail source: read-only summary of Global Settings (where the values actually live). -->
                        <TextBlock Style="{StaticResource T.Label}">📧 GLOBAL MAIL  (from Global Settings — values that the radio buttons below use)</TextBlock>
                        <Border Background="#FF0B1220" BorderBrush="{StaticResource B.Line}" BorderThickness="1"
                                CornerRadius="8" Padding="14,10" Margin="0,6,0,0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Gmail pool     :" Style="{StaticResource T.Mini}"
                                               Foreground="{StaticResource B.TextMuted}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" x:Name="GmailPoolSummary" Style="{StaticResource T.Mini}"
                                               Foreground="{StaticResource B.Text}" VerticalAlignment="Center" FontFamily="{StaticResource F.Mono}"
                                               TextWrapping="Wrap" />
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Custom domain  :" Style="{StaticResource T.Mini}"
                                               Foreground="{StaticResource B.TextMuted}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" x:Name="DomainSummary" Style="{StaticResource T.Mini}"
                                               Foreground="{StaticResource B.Text}" VerticalAlignment="Center" FontFamily="{StaticResource F.Mono}" />
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Custom mail    :" Style="{StaticResource T.Mini}"
                                               Foreground="{StaticResource B.TextMuted}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" x:Name="CustomMailSummary" Style="{StaticResource T.Mini}"
                                               Foreground="{StaticResource B.Text}" VerticalAlignment="Center" FontFamily="{StaticResource F.Mono}" />
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Token mail     :" Style="{StaticResource T.Mini}"
                                               Foreground="{StaticResource B.TextMuted}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" x:Name="OutlookPoolSummary" Style="{StaticResource T.Mini}"
                                               Foreground="{StaticResource B.Text}" VerticalAlignment="Center" FontFamily="{StaticResource F.Mono}"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Per-run mail mode picker (same UX as Accio). Default = AutoSource(). -->
                        <TextBlock Style="{StaticResource T.Label}" Margin="0,18,0,6">✉️ MAIL MODE FOR THIS RUN  (override the auto-pick if you want)</TextBlock>
                        <RadioButton x:Name="ModePool"   GroupName="Mode" Style="{StaticResource S.RadioButton}" Content="1) Gmail Pool (rotate dots — writes GMAIL_USER to script .env)" />
                        <RadioButton x:Name="ModeTemp"   GroupName="Mode" Margin="0,8,0,0" Style="{StaticResource S.RadioButton}" Content="2) Temp Mail (script generates its own address)" />
                        <RadioButton x:Name="ModeDomain" GroupName="Mode" Margin="0,8,0,0" Style="{StaticResource S.RadioButton}" Content="3) Custom Domain (alice.json → active domain)" />
                        <RadioButton x:Name="ModeCustom" GroupName="Mode" Margin="0,8,0,0" Style="{StaticResource S.RadioButton}" Content="4) Custom Mail (one Gmail + app password, used once)" />
                        <RadioButton x:Name="ModeSemi"   GroupName="Mode" Margin="0,8,0,0" Style="{StaticResource S.RadioButton}" Content="5) Semi Automation (manual OTP)" />
                        <RadioButton x:Name="ModeNoPx"   GroupName="Mode" Margin="0,8,0,0" Style="{StaticResource S.RadioButton}" Content="6) No Proxy (force direct)" />
                        <RadioButton x:Name="ModeTest"   GroupName="Mode" Margin="0,8,0,0" Style="{StaticResource S.RadioButton}" Content="7) Test (no real signup — log stream only)" />
                        <RadioButton x:Name="ModeOutlook" GroupName="Mode" Margin="0,8,0,0" Style="{StaticResource S.RadioButton}"
                                     Content="8) Token Mail (Outlook pool — rotates, OTP read from the inbox)" />

                        <!-- SIGNUP URL - the page this tool's create run is driven
                             to, same box accio has. Only tools that actually take a
                             URL on the create path show it (MiniMax today); for the
                             others the whole block stays collapsed. -->
                        <Border x:Name="CreateUrlSection" Background="#FF0B1220" BorderBrush="{StaticResource B.Line}" BorderThickness="1"
                                CornerRadius="8" Padding="14,10" Margin="0,16,0,0" Visibility="Collapsed">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="🌐  SIGNUP URL:"
                                               Style="{StaticResource T.Label}"
                                               VerticalAlignment="Center" Margin="0,0,12,0" />

                                    <TextBox Grid.Column="1" x:Name="CreateUrlBox"
                                             Style="{StaticResource S.TextBox}"
                                             FontFamily="{StaticResource F.Mono}"
                                             LostFocus="OnCreateUrlChanged"
                                             ToolTip="Where accounts of the next run are created. Any http(s) URL; empty = this tool's default page." />
                                </Grid>
                                <TextBlock x:Name="CreateUrlHint" Style="{StaticResource T.Mini}" Margin="0,6,0,0"
                                           TextWrapping="Wrap"
                                           Text="Passed to the create run as --url. Empty = the tool's default signup page." />
                            </StackPanel>
                        </Border>

                        <!-- proxy override -->
                        <Border Background="#FF0B1220" BorderBrush="{StaticResource B.Line}" BorderThickness="1"
                                CornerRadius="8" Padding="14,10" Margin="0,16,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="🔌  PROXY:"
                                           Style="{StaticResource T.Label}"
                                           VerticalAlignment="Center" Margin="0,0,12,0" />

                                <ToggleButton x:Name="ProxyToggle" Grid.Column="1"
                                              Content="ON" Width="80"
                                              Checked="OnProxyToggleChanged"
                                              Unchecked="OnProxyToggleChanged"
                                              ToolTip="Override proxy. OFF = appends --no-proxy to the script invocation." />

                                <TextBlock x:Name="ProxyHint" Grid.Column="2"
                                           Margin="14,0,0,0" VerticalAlignment="Center"
                                           Style="{StaticResource T.Mini}"
                                           Text="ON → use the script's own proxy / .env settings.  OFF → --no-proxy." />
                            </Grid>
                        </Border>

                        <!-- total / at-once / headless -->
                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Total :"
                                       Style="{StaticResource T.Label}"
                                       VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBox Grid.Column="1" x:Name="TotalBox" Text="1" Style="{StaticResource QtyBox}"
                                     PreviewTextInput="OnDigitsOnly"
                                     ToolTip="How many accounts to create in TOTAL for this run (e.g. 10)." />

                            <TextBlock Grid.Column="2" Text="At once :"
                                       Style="{StaticResource T.Label}"
                                       VerticalAlignment="Center" Margin="20,0,12,0" />
                            <TextBox Grid.Column="3" x:Name="AtOnceBox" Text="2" Style="{StaticResource QtyBox}"
                                     PreviewTextInput="OnDigitsOnly"
                                     ToolTip="How many browsers may be open AT THE SAME TIME (e.g. 3). New runs start as previous ones finish." />

                            <ToggleButton Grid.Column="4" x:Name="HeadlessToggle"
                                          Content="HEADLESS: OFF"
                                          Width="150" Height="38" Margin="20,0,0,0"
                                          VerticalAlignment="Center"
                                          Checked="OnHeadlessToggleChanged"
                                          Unchecked="OnHeadlessToggleChanged"
                                          ToolTip="ON = every script this panel starts gets --headless (no browser window). OFF = visible browser." />

                            <TextBlock Grid.Column="5" x:Name="HeadlessHint"
                                       Margin="14,0,0,0" VerticalAlignment="Center"
                                       Style="{StaticResource T.Mini}"
                                       Text="ON → scripts run with --headless.  OFF → visible browser." />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="Speed delay (s):" Style="{StaticResource T.Label}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBox x:Name="DelaySecondsBox" Text="3" Style="{StaticResource QtyBox}" Width="70"
                                     PreviewTextInput="OnDigitsOnly"
                                     ToolTip="Delay between starting accounts for this tool. Lower = faster." />
                            <TextBlock Text="Lower value = faster start spacing. X-trick is Accio-only." Style="{StaticResource T.Mini}" VerticalAlignment="Center" Margin="12,0,0,0" />
                        </StackPanel>

                        <!-- run / stop / preflight -->
                        <Grid Margin="0,14,0,0" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Width="120">
                                <Button x:Name="RunBtn" Content="▶  RUN"
                                        Style="{StaticResource S.PrimaryButton}"
                                        Click="OnRun" />
                                <Button x:Name="StopBtn" Content="⏹  STOP"
                                        Style="{StaticResource S.GhostButton}"
                                        Visibility="Collapsed"
                                        Click="OnStop" />
                            </Grid>
                            <Button Grid.Column="1" x:Name="PreflightBtn" Content="🔍  PRE-FLIGHT"
                                    Style="{StaticResource S.GhostButton}"
                                    Width="140" Margin="14,0,0,0"
                                    Click="OnPreflight" />
                        </Grid>

                        <!-- progress -->
                        <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,18,0,0">
                            <TextBlock x:Name="ProgressText" Text="00 / 00"
                                       FontFamily="{StaticResource F.Mono}" FontSize="12"
                                       Foreground="{StaticResource B.TextDim}" />
                            <ProgressBar x:Name="Progress" Height="8" Margin="0,8,0,0"
                                         Minimum="0" Maximum="100" Value="0"
                                         Background="#FF0B1220"
                                         Foreground="{StaticResource B.AccentA}"
                                         BorderThickness="0" />
                        </StackPanel>

                        <!-- live log -->
                        <Grid Margin="0,18,0,6">
                            <TextBlock Text="LIVE LOG  (python stdout)" Style="{StaticResource T.Label}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="⤡  SMALLER" Style="{StaticResource S.GhostButton}"
                                        Height="28" FontSize="11"
                                        Click="OnLogSmaller"
                                        ToolTip="Shrink the live log" />
                                <Button Content="⤢  BIGGER" Style="{StaticResource S.GhostButton}"
                                        Height="28" FontSize="11" Margin="8,0,0,0"
                                        Click="OnLogBigger"
                                        ToolTip="Grow the live log (or drag the grip under it)" />
                                <Button Content="CLEAR" Style="{StaticResource S.GhostButton}"
                                        Height="28" FontSize="11" Margin="8,0,0,0"
                                        Click="OnClearLiveLog" />
                                <Button Content="🖹  COPY LOG" Style="{StaticResource S.GhostButton}"
                                        Height="28" FontSize="11" Margin="8,0,0,0"
                                        Click="OnCopyLiveLog" />
                            </StackPanel>
                        </Grid>
                        <!-- Fixed height rather than MaxHeight, so the box can be
                             dragged both ways; ScrollToEnd on every append keeps
                             the newest line visible instead of making the user
                             chase the scrollbar. -->
                        <Border x:Name="LogHost" Background="#FF06080C" BorderBrush="{StaticResource B.Line}"
                                BorderThickness="1" CornerRadius="8" Padding="12,8"
                                Height="240" MinHeight="90">
                            <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <TextBlock x:Name="LogBox"
                                           FontFamily="{StaticResource F.Mono}" FontSize="11.5"
                                           Foreground="{StaticResource B.Text}" TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Border>
                        <Thumb x:Name="LogResizeGrip" Height="10" Margin="0,3,0,0"
                               Cursor="SizeNS" Opacity="0.6"
                               ToolTip="Drag up or down to resize the live log"
                               DragDelta="OnLogResize">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Border Background="Transparent" Padding="0,4">
                                        <Rectangle Height="2" RadiusX="1" RadiusY="1"
                                                   Fill="{StaticResource B.LineStrong}" />
                                    </Border>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </StackPanel>
                </Border>

                <!-- ============== TAB: LOGIN ============== -->
                <Border x:Name="TabLogin" Style="{StaticResource S.Card}" Margin="0,0,0,16" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="LOGIN ACCOUNT (COOKIE REPLAY)" Style="{StaticResource T.Section}" />
                        <Rectangle Style="{StaticResource S.Rule}" />

                        <TextBlock x:Name="LoginHint"
                                   Text="The Login script reads cookies.txt in the script's working folder. Tick rows, then click VERIFY LOGIN to test each cookie set, or REFRESH to re-read the script's files."
                                   Style="{StaticResource T.Mini}" Margin="0,0,0,12" />

                        <!-- Per-tool LOGIN URL - mirrors Accio's LoginTargetUrlBox. The
                             row "🔑 Login" run hands this to the login script as its
                             url argument so the session opens exactly here (paste a
                             referral link, e.g. a devin.ai org onboarding link with a
                             ref query string).  Saved per tool in the panel's
                             tool-settings.json. -->
                        <Border Background="#FF0B1220" BorderBrush="{StaticResource B.Line}" BorderThickness="1"
                                CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="🌐 URL:"
                                               Style="{StaticResource T.Label}"
                                               VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <TextBox Grid.Column="1" x:Name="LoginUrlBox"
                                             Style="{StaticResource S.TextBox}"
                                             FontFamily="{StaticResource F.Mono}"
                                             TextWrapping="NoWrap"
                                             ToolTip="Landing page the row 🔑 Login run opens - edit to use a referral link, then SAVE SETTINGS." />
                                </Grid>
                                <TextBlock Style="{StaticResource T.Mini}" Margin="0,6,0,0"
                                           Foreground="{StaticResource B.TextMuted}"
                                           TextWrapping="Wrap"
                                           Text="Where the row 🔑 Login run opens the session (verified there). Empty = tool default; a bare host gets https:// prepended. Click 💾 SAVE SETTINGS to persist." />
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,12,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" x:Name="LoginSelAllBtn" Content="☑  ALL"
                                    Style="{StaticResource S.GhostButton}" Width="90"
                                    Click="OnLoginSelectAll" />
                            <Button Grid.Column="1" x:Name="LoginClearBtn" Content="☐  NONE"
                                    Style="{StaticResource S.GhostButton}" Width="100" Margin="8,0,0,0"
                                    Click="OnLoginSelectNone" />
                            <Button Grid.Column="2" x:Name="LoginVerifyBtn" Content="🔑  VERIFY LOGIN"
                                    Style="{StaticResource S.PrimaryButton}" Width="170" Margin="16,0,0,0"
                                    Click="OnLoginVerifySelected" />
                            <Button Grid.Column="3" x:Name="LoginRefreshBtn" Content="🔄  REFRESH"
                                    Style="{StaticResource S.GhostButton}" Width="120" Margin="8,0,0,0"
                                    Click="OnRefreshLogin" />
                        </Grid>

                        <Grid Margin="0,4,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="64" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="☐"      Style="{StaticResource HeadText}" />
                            <TextBlock Grid.Column="1" Text="#"       Style="{StaticResource HeadText}" />
                            <TextBlock Grid.Column="2" Text="EMAIL"   Style="{StaticResource HeadText}" />
                            <TextBlock Grid.Column="3" Text="COOKIES" Style="{StaticResource HeadText}" />
                            <TextBlock Grid.Column="4" Text="VERIFY"  Style="{StaticResource HeadText}" />
                            <TextBlock Grid.Column="5" Text="LOGIN"   Style="{StaticResource HeadText}" />
                            <TextBlock Grid.Column="6" Text="DELETE"  Style="{StaticResource HeadText}" />
                            <TextBlock Grid.Column="7" Text="VIEW"    Style="{StaticResource HeadText}" />
                        </Grid>
                        <Rectangle Height="1" Fill="{StaticResource B.Line}" />

                        <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="LoginList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34" />
                                                <ColumnDefinition Width="40" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="64" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" IsChecked="{Binding Selected, Mode=TwoWay}"
                                                      Style="{StaticResource S.CheckBox}"
                                                      VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding IdLabel}"
                                                       FontFamily="{StaticResource F.Mono}" FontSize="12"
                                                       Foreground="{StaticResource B.TextDim}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding EmailUsed}"
                                                       FontFamily="{StaticResource F.Mono}" FontSize="12"
                                                       Foreground="{StaticResource B.Text}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{Binding CookieLabel}"
                                                       FontSize="11.5"
                                                       Foreground="{StaticResource B.TextDim}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="4" Text="{Binding LastVerify}"
                                                       FontFamily="Segoe UI Semibold" FontSize="11"
                                                       Foreground="{Binding LastVerifyColor}"
                                                       VerticalAlignment="Center" />
                                             <Button Grid.Column="5" Content="🔑 Login"
                                                     Style="{StaticResource S.GhostButton}"
                                                     Height="28" FontSize="11" Margin="0,0,4,0"
                                                     AutomationProperties.AutomationId="LoginRowBtn"
                                                     Click="OnLoginOne" />
                                            <Button Grid.Column="6" Content="🗑 Del"
                                                    Style="{StaticResource S.GhostButton}"
                                                    Height="28" FontSize="11" Margin="4,0,4,0"
                                                    Click="OnDeleteAccount" />
                                            <Button Grid.Column="7" Content="View"
                                                    Style="{StaticResource S.GhostButton}"
                                                    Height="28" FontSize="11" Margin="4,0,0,0"
                                                    Click="OnViewCookie" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- ============== TAB: EXTRA (everything except Create & Login) ============== -->
                <Border x:Name="TabExtra" Style="{StaticResource S.Card}" Margin="0,0,0,16" Visibility="Collapsed">
                    <StackPanel Margin="22,18">
                        <TextBlock x:Name="ExtraHeading" Style="{StaticResource T.Label}" FontSize="15">🎁 EXTRA TOOLS  -  Auto · Check · Force all</TextBlock>
                        <TextBlock x:Name="ExtraBlurb" Style="{StaticResource T.Mini}" Foreground="{StaticResource B.TextMuted}" Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   Text="AUTO / CHECK / FORCE run the tool's login script on the accounts that need it (hidden browser). Every button streams its output below." />

                        <TextBlock Style="{StaticResource T.Label}" Margin="0,20,0,8">ACCOUNT  (login side)</TextBlock>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="AutoBtn"  Content="🔄  AUTO  (ONE account, unused in 24h)" Style="{StaticResource S.PrimaryButton}" Click="OnExtraAuto"  Margin="0,0,10,0" />
                            <Button x:Name="CheckBtn" Content="🩺  CHECK  (cookie health)"     Style="{StaticResource S.PrimaryButton}" Click="OnExtraCheck" Margin="0,0,10,0" />
                            <Button x:Name="ForceBtn" Content="⚡  FORCE ALL  (every account)" Style="{StaticResource S.PrimaryButton}" Click="OnExtraForce" />
                        </StackPanel>

                        <!-- CLAIM is MiniMax-specific: shown only when THIS tool actually
                             ships a claim_advanced.py next to its login script. The
                             code-behind flips ClaimSection.Visibility accordingly. -->
                        <StackPanel x:Name="ClaimSection" Visibility="Collapsed">
                            <TextBlock x:Name="ClaimHeading" Style="{StaticResource T.Label}" Margin="0,22,0,8">CLAIM  (MiniMax Daily Check-in)</TextBlock>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="ClaimAllBtn"  Content="🎁  CLAIM ALL  (untouched in 24h)" Style="{StaticResource S.PrimaryButton}" Click="OnExtraClaimAll"  Margin="0,0,10,0" />
                                <Button x:Name="ClaimListBtn" Content="📋  CLAIM LIST"                    Style="{StaticResource S.PrimaryButton}" Click="OnExtraClaimList" Margin="0,0,14,0" />
                                <TextBlock Text="Account #:" Style="{StaticResource T.Label}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox x:Name="ClaimSlotsBox" Width="150" Text="" Style="{StaticResource QtyBox}" />
                                <Button x:Name="ClaimSlotBtn" Content="▶  CLAIM #" Style="{StaticResource S.PrimaryButton}" Click="OnExtraClaimSlots" Margin="10,0,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Browser mode for EVERY button on this tab. This is a
                             SECOND VIEW of the Create tab's HEADLESS switch - not a
                             new setting: flipping either one updates the other and
                             writes the same per-tool value, so it survives a
                             restart. -->
                        <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                            <ToggleButton x:Name="ExtraHeadlessToggle"
                                          Content="HEADLESS: OFF"
                                          Width="150" Height="34"
                                          VerticalAlignment="Center"
                                          Checked="OnExtraHeadlessChanged"
                                          Unchecked="OnExtraHeadlessChanged"
                                          ToolTip="Same switch as the Create tab. ON = every script this tab starts gets --headless (no browser window). OFF = visible browser." />
                            <TextBlock x:Name="ExtraHeadlessHint" Style="{StaticResource T.Mini}"
                                       Foreground="{StaticResource B.TextMuted}"
                                       TextWrapping="Wrap" VerticalAlignment="Center"
                                       Margin="14,0,0,0"
                                       Text="Applies to AUTO, CHECK, FORCE ALL and every CLAIM button." />
                        </StackPanel>

                        <!-- STOP for whatever the Extra buttons started. It kills the
                             script's whole process tree, so the browser it opened goes
                             with it. Shown only while something runs. -->
                        <Grid Margin="0,22,0,8">
                            <TextBlock Text="LIVE OUTPUT" Style="{StaticResource T.Label}"
                                       VerticalAlignment="Center" />
                            <Button x:Name="ExtraStopBtn" Content="⏹  STOP"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource S.GhostButton}"
                                    Height="28" FontSize="11.5" Padding="14,0"
                                    Visibility="Collapsed"
                                    Click="OnExtraStop" />
                        </Grid>
                        <Border CornerRadius="8" Padding="12,8" MinHeight="140" MaxHeight="280">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="ExtraLog" FontFamily="{StaticResource F.Mono}" FontSize="11.5"
                                           Foreground="{StaticResource B.Text}" TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ============== TAB: SETTINGS ============== -->
                <Border x:Name="TabSettings" Style="{StaticResource S.Card}" Margin="0,0,0,16" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="SettingsHeader" Text="TOOL PATHS &amp; ARG TEMPLATES" Style="{StaticResource T.Section}" />
                        <Rectangle Style="{StaticResource S.Rule}" />

                        <!-- ===== MAIL: per-tool ban list (Feature 1). Saves the
                             moment you click; never touches Global Settings. ===== -->
                        <TextBlock Style="{StaticResource T.Label}" Margin="0,0,0,6">
                            📬 MAIL  (ban a Gmail for THIS tool only)
                        </TextBlock>
                        <TextBlock x:Name="MailBanNote" Style="{StaticResource T.Mini}" Margin="2,0,0,8"
                                   TextWrapping="Wrap" Foreground="{StaticResource B.TextMuted}"
                                   Text="Choose which Gmail from Global Settings this tool may use. A BANNED Gmail is simply skipped for THIS tool — the remaining Gmails keep rotating. Your Global Settings (Method 2) is never changed, so every other tool keeps using it normally." />
                        <Border Background="#FF0B1220" BorderBrush="{StaticResource B.Line}" BorderThickness="1"
                                CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="190" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="GMAIL"              Style="{StaticResource HeadText}" />
                                    <TextBlock Grid.Column="1" Text="STATUS (this tool)" Style="{StaticResource HeadText}" />
                                    <TextBlock Grid.Column="2" Text="ACTION"             Style="{StaticResource HeadText}" />
                                </Grid>
                                <Rectangle Height="1" Fill="{StaticResource B.Line}" />
                                <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                                    <ItemsControl x:Name="MailList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="150" />
                                                        <ColumnDefinition Width="190" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Email}"
                                                               FontFamily="{StaticResource F.Mono}" FontSize="12"
                                                               Foreground="{StaticResource B.Text}"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding StatusLabel}"
                                                               FontSize="11.5" FontFamily="Segoe UI Semibold"
                                                               Foreground="{Binding StatusColor}" VerticalAlignment="Center" />
                                                    <Button Grid.Column="2" Content="{Binding ActionLabel}"
                                                            Style="{StaticResource S.GhostButton}"
                                                            Height="30" FontSize="11.5" MinWidth="160"
                                                            HorizontalAlignment="Left"
                                                            AutomationProperties.AutomationId="MailToggleBtn"
                                                            Click="OnMailToggle" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <TextBlock x:Name="MailBanEmpty" Style="{StaticResource T.Mini}" Margin="2,6,0,0"
                                           Foreground="{StaticResource B.TextMuted}" Visibility="Collapsed"
                                           Text="No Gmails configured in Global Settings → Method 2. Add one there first." />
                                <TextBlock x:Name="MailBanAllBanned" Style="{StaticResource T.Mini}" Margin="2,8,0,0"
                                           Foreground="#FFF87171" TextWrapping="Wrap" Visibility="Collapsed"
                                           Text="⚠ Every Gmail is BANNED for this tool — nothing can be picked. Add one back here to keep creating accounts." />
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource T.Label}" Margin="0,14,0,6">
                            🐍 PYTHON INTERPRETER
                        </TextBlock>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="PythonExeBox" Style="{StaticResource S.TextBox}"
                                     FontFamily="{StaticResource F.Mono}" />
                            <Button Grid.Column="1" Content="📂 Browse"
                                    Style="{StaticResource S.GhostButton}" Margin="8,0,0,0"
                                    Click="OnBrowsePython" />
                            <Button Grid.Column="2" Content="🔍 Detect"
                                    Style="{StaticResource S.GhostButton}" Margin="8,0,0,0"
                                    Click="OnDetectPython" />
                        </Grid>
                        <TextBlock x:Name="PythonHint" Style="{StaticResource T.Mini}" Margin="2,6,0,0"
                                   Text="Empty = 'python' / 'py -3' on PATH." />

                        <TextBlock Style="{StaticResource T.Label}" Margin="0,18,0,6">
                            📜 CREATE SCRIPT  (account-creation .py)
                        </TextBlock>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="CreateScriptBox" Style="{StaticResource S.TextBox}"
                                     FontFamily="{StaticResource F.Mono}" />
                            <Button Grid.Column="1" Content="📂 Browse"
                                    Style="{StaticResource S.GhostButton}" Margin="8,0,0,0"
                                    Click="OnBrowseCreateScript" />
                        </Grid>

                        <TextBlock Style="{StaticResource T.Label}" Margin="0,18,0,6">
                            🔑 LOGIN SCRIPT  (cookie-replay .py)
                        </TextBlock>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="LoginScriptBox" Style="{StaticResource S.TextBox}"
                                     FontFamily="{StaticResource F.Mono}" />
                            <Button Grid.Column="1" Content="📂 Browse"
                                    Style="{StaticResource S.GhostButton}" Margin="8,0,0,0"
                                    Click="OnBrowseLoginScript" />
                        </Grid>

                        <TextBlock Style="{StaticResource T.Label}" Margin="0,18,0,6">
                            📁 TOOL WORKING DIRECTORY  (folder that holds .env, accounts.txt, cookies.txt)
                        </TextBlock>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="WorkDirBox" Style="{StaticResource S.TextBox}"
                                     FontFamily="{StaticResource F.Mono}" />
                            <Button Grid.Column="1" Content="📂 Browse"
                                    Style="{StaticResource S.GhostButton}" Margin="8,0,0,0"
                                    Click="OnBrowseWorkDir" />
                        </Grid>

                        <TextBlock Style="{StaticResource T.Label}" Margin="0,18,0,6">
                            ⚙ CREATE ARG TEMPLATE  (substituted at run-time)
                        </TextBlock>
                        <TextBox x:Name="CreateArgsBox" Style="{StaticResource S.TextBox}"
                                 FontFamily="{StaticResource F.Mono}" TextWrapping="Wrap" AcceptsReturn="True"
                                 MinHeight="48" />
                        <TextBlock Style="{StaticResource T.Mini}" Margin="2,6,0,0">
                            Placeholders:  <Run FontFamily="{StaticResource F.Mono}">{count}</Run> ·
                            <Run FontFamily="{StaticResource F.Mono}">{gmail}</Run> ·
                            <Run FontFamily="{StaticResource F.Mono}">{password}</Run> ·
                            <Run FontFamily="{StaticResource F.Mono}">{proxy}</Run> ·
                            <Run FontFamily="{StaticResource F.Mono}">{domain}</Run> ·
                            <Run FontFamily="{StaticResource F.Mono}">{target}</Run>
                        </TextBlock>

                        <TextBlock Style="{StaticResource T.Label}" Margin="0,18,0,6">
                            ⚙ LOGIN ARG TEMPLATE  (substituted at run-time)
                        </TextBlock>
                        <TextBox x:Name="LoginArgsBox" Style="{StaticResource S.TextBox}"
                                 FontFamily="{StaticResource F.Mono}" TextWrapping="Wrap" AcceptsReturn="True"
                                 MinHeight="36" />

                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button x:Name="SaveSettingsBtn" Content="💾  SAVE SETTINGS"
                                    Style="{StaticResource S.PrimaryButton}" Width="180"
                                    Click="OnSaveSettings" />
                            <Button x:Name="ReloadSettingsBtn" Content="🔄  RELOAD"
                                    Style="{StaticResource S.GhostButton}" Width="120" Margin="8,0,0,0"
                                    Click="OnReloadSettings" />
                        </StackPanel>

                        <TextBlock x:Name="SettingsHint" Style="{StaticResource T.Mini}" Margin="2,10,0,0"
                                   Text="Save once after typing — settings live in %APPDATA%\AISuitePanel\tool-settings.json." />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
