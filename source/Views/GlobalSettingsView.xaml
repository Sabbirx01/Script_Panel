<UserControl x:Class="AISuitePanel.Views.GlobalSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource T.Label}">
            <Setter Property="Margin" Value="0,0,0,7" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================== BACK ============================== -->
        <Button x:Name="BackButton" Grid.Row="0"
                Content="⬅  BACK TO DASHBOARD"
                Style="{StaticResource S.GhostButton}"
                HorizontalAlignment="Left"
                Margin="34,24,0,0"
                Click="OnBack" />

        <!-- ============================== TITLE ============================== -->
        <StackPanel Grid.Row="1" Margin="34,18,34,0">
            <TextBlock Text="MAIN DASHBOARD &gt; GLOBAL MAIL SETTINGS" Style="{StaticResource T.Title}" FontSize="21" />
            <TextBlock x:Name="SubLine" Style="{StaticResource T.Sub}" FontSize="12.5" Margin="0,8,0,0" />
        </StackPanel>

        <!-- ============================== BODY ============================== -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="34,20,22,26">

                <!-- ===================== METHOD 1 ===================== -->
                <Border Style="{StaticResource S.Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="METHOD 1 - TEMP MAIL CONFIGURATION" Style="{StaticResource T.Section}" />
                        <Rectangle Style="{StaticResource S.Rule}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Built-in Service :"
                                       Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,0,14" />
                            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="ServiceCombo"
                                      Style="{StaticResource S.ComboBox}"
                                      Width="240" HorizontalAlignment="Left"
                                      Margin="0,0,0,14" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Custom API Key :"
                                       Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                            <StackPanel Grid.Row="1" Grid.Column="1">
                                <TextBox x:Name="ApiKeyBox"
                                         Style="{StaticResource S.TextBox}"
                                         FontFamily="{StaticResource F.Mono}"
                                         MaxWidth="520" HorizontalAlignment="Left"
                                         MinWidth="360" />
                                <TextBlock Text="Optional - leave empty to use the built-in key."
                                           Style="{StaticResource T.Mini}" Margin="2,6,0,0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===================== METHOD 2 ===================== -->
                <Border Style="{StaticResource S.Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="METHOD 2 - DOTTED GMAIL ROUTING &amp; MULTI-GMAIL MANAGER"
                                   Style="{StaticResource T.Section}" />
                        <Rectangle Style="{StaticResource S.Rule}" />

                        <TextBlock Text="Add Gmail List  (Gmail : App Password)"
                                   Style="{StaticResource FieldLabel}" />

                        <ItemsControl x:Name="GmailList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="230" />
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="44" />
                                        </Grid.ColumnDefinitions>

                                        <TextBox Grid.Column="0" x:Name="EmailCell"
                                                 Style="{StaticResource S.CellBox}"
                                                 Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />

                                        <Grid Grid.Column="1" Margin="8,0,0,0">
                                            <TextBox x:Name="PassCell"
                                                     Style="{StaticResource S.CellBox}"
                                                     Text="{Binding AppPassword, UpdateSourceTrigger=PropertyChanged}" />

                                            <Border Background="{StaticResource B.Field}"
                                                    BorderBrush="{StaticResource B.Line}" BorderThickness="1"
                                                    CornerRadius="10" Padding="11,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Reveal}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="••••-••••-••••-••••"
                                                           VerticalAlignment="Center"
                                                           FontFamily="{StaticResource F.Mono}"
                                                           FontSize="12.5"
                                                           Foreground="{StaticResource B.TextMuted}" />
                                            </Border>
                                        </Grid>

                                        <Button Grid.Column="2"
                                                Content="👁"
                                                Style="{StaticResource S.GhostButton}"
                                                Margin="8,0,0,0"
                                                Click="OnToggleRowReveal"
                                                ToolTip="Show / hide this app password" />

                                        <Button Grid.Column="3"
                                                Content="✕"
                                                Style="{StaticResource S.GhostButton}"
                                                Margin="8,0,0,0"
                                                Click="OnRemoveGmail"
                                                ToolTip="Remove this Gmail" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="GmailEmpty" Text="No Gmail added yet."
                                   Style="{StaticResource T.Mini}" Margin="2,2,0,0" />

                        <Button x:Name="AddGmailButton"
                                Content="+  ADD GMAIL"
                                Style="{StaticResource S.GhostButton}"
                                HorizontalAlignment="Left"
                                Margin="0,12,0,0"
                                Click="OnAddGmail" />

                        <Rectangle Style="{StaticResource S.Rule}" Margin="0,20,0,18" />

                        <RadioButton x:Name="RoundRobinRadio"
                                     GroupName="Routing"
                                     Style="{StaticResource S.RadioButton}"
                                     Content="Round-Robin / Auto Rotate Between Gmails"
                                     IsChecked="True" />
                        <TextBlock Text="Each new account takes the next Gmail in the list; the position is remembered across restarts."
                                   Style="{StaticResource T.Mini}" Margin="29,6,0,0" />

                        <CheckBox x:Name="AntiDuplicateCheck"
                                  Style="{StaticResource S.CheckBox}"
                                  Content="Auto-block reused dotted aliases per tool"
                                  Margin="0,16,0,0" />
                        <TextBlock x:Name="AliasUsage"
                                   Style="{StaticResource T.Mini}" Margin="30,6,0,0" />
                    </StackPanel>
                </Border>

                <!-- ===================== METHOD 4 ===================== -->
                <Border Style="{StaticResource S.Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="METHOD 4 - CUSTOM MAIL (ONE-SHOT GMAIL)"
                                   Style="{StaticResource T.Section}" />
                        <Rectangle Style="{StaticResource S.Rule}" />

                        <TextBlock Style="{StaticResource T.Mini}" Margin="0,0,0,12">
                            One fixed Gmail + 16-char app password, used once for the next batch
                            and then cleared (BAT [1.4]).
                        </TextBlock>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="44" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Gmail Address :"
                                       Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,0,14" />
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="CustomMailEmailBox"
                                     Style="{StaticResource S.TextBox}"
                                     FontFamily="{StaticResource F.Mono}"
                                     MinWidth="360" MaxWidth="520" HorizontalAlignment="Left"
                                     Margin="0,0,0,14" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="App Password :"
                                       Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                            <Grid Grid.Row="1" Grid.Column="1" MaxWidth="520" HorizontalAlignment="Left">
                                <TextBox x:Name="CustomMailPassBox" Style="{StaticResource S.TextBox}"
                                         FontFamily="{StaticResource F.Mono}" />
                                <Border x:Name="CustomMailPassMask"
                                        Background="{StaticResource B.Field}"
                                        BorderBrush="{StaticResource B.Line}" BorderThickness="1"
                                        CornerRadius="10" Padding="13,0">
                                    <TextBlock Text="••••-••••-••••-••••"
                                               VerticalAlignment="Center"
                                               FontFamily="{StaticResource F.Mono}"
                                               FontSize="14"
                                               Foreground="{StaticResource B.TextMuted}" />
                                </Border>
                            </Grid>
                            <Button Grid.Row="1" Grid.Column="2"
                                    x:Name="CustomMailPassEye"
                                    Content="👁"
                                    Style="{StaticResource S.GhostButton}"
                                    Margin="8,0,0,0"
                                    Click="OnToggleCustomMailPass"
                                    ToolTip="Show / hide the app password" />

                            <CheckBox Grid.Row="2" Grid.Column="1" x:Name="CustomMailClearCheck"
                                      Style="{StaticResource S.CheckBox}"
                                      Content="Clear after use (recommended)"
                                      Margin="0,14,0,0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===================== METHOD 3 ===================== -->
                <Border Style="{StaticResource S.Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="METHOD 3 - CUSTOM DOMAIN (CLOUDFLARE CATCH-ALL)"
                                   Style="{StaticResource T.Section}" />
                        <Rectangle Style="{StaticResource S.Rule}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="44" />
                            </Grid.ColumnDefinitions>
                             <Grid.RowDefinitions>
                                 <RowDefinition Height="Auto" />
                                 <RowDefinition Height="Auto" />
                                 <RowDefinition Height="Auto" />
                                 <RowDefinition Height="Auto" />
                                 <RowDefinition Height="Auto" />
                             </Grid.RowDefinitions>

                             <TextBlock Grid.Row="0" Grid.Column="0" Text="Custom Domain :"
                                       Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,0,14" />
                            <TextBox x:Name="DomainBox" Grid.Row="0" Grid.Column="1"
                                     Style="{StaticResource S.TextBox}"
                                     FontFamily="{StaticResource F.Mono}"
                                     MinWidth="360" MaxWidth="520" HorizontalAlignment="Left"
                                     Margin="0,0,0,14" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Forward Target :"
                                       Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,0,14" />
                            <TextBox x:Name="ForwardBox" Grid.Row="1" Grid.Column="1"
                                     Style="{StaticResource S.TextBox}"
                                     FontFamily="{StaticResource F.Mono}"
                                     MinWidth="360" MaxWidth="520" HorizontalAlignment="Left"
                                     Margin="0,0,0,14" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Target App Pass :"
                                       Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                            <Grid Grid.Row="2" Grid.Column="1" MaxWidth="520" HorizontalAlignment="Left">
                                <TextBox x:Name="TargetPassBox" Style="{StaticResource S.TextBox}"
                                         FontFamily="{StaticResource F.Mono}" />
                                <Border x:Name="TargetPassMask"
                                        Background="{StaticResource B.Field}"
                                        BorderBrush="{StaticResource B.Line}" BorderThickness="1"
                                        CornerRadius="10" Padding="13,0">
                                    <TextBlock Text="••••-••••-••••-••••"
                                               VerticalAlignment="Center"
                                               FontFamily="{StaticResource F.Mono}"
                                               FontSize="14"
                                               Foreground="{StaticResource B.TextMuted}" />
                                </Border>
                            </Grid>
                            <Button Grid.Row="2" Grid.Column="2"
                                    x:Name="TargetPassEye"
                                    Content="👁"
                                    Style="{StaticResource S.GhostButton}"
                                    Margin="8,0,0,0"
                                    Click="OnToggleTargetPass"
                                    ToolTip="Show / hide the app password" />

                             <TextBlock Grid.Row="3" Grid.Column="1" Text="Mail sent to *@your-domain is read back through this inbox."
                                        Style="{StaticResource T.Mini}" Margin="2,6,0,0" />

                             <!-- Proves the credentials before a run wastes a batch:
                                  logs in over IMAP and reports what is actually readable. -->
                             <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal"
                                         VerticalAlignment="Center" Margin="2,14,0,0">
                                 <Button x:Name="TestDomainInboxButton"
                                         Content="Test mailbox"
                                         Style="{StaticResource S.GhostButton}"
                                         Padding="14,7"
                                         Click="OnTestDomainInbox"
                                         ToolTip="Log in to the forward target over IMAP with this app password and report what the panel can read" />
                                 <TextBlock x:Name="DomainInboxStatus"
                                            Style="{StaticResource T.Mini}"
                                            VerticalAlignment="Center"
                                            Margin="14,0,0,0"
                                            TextWrapping="Wrap"
                                            MaxWidth="420" />
                             </StackPanel>
                         </Grid>
                    </StackPanel>
                </Border>

                <!-- ===================== ACCOUNT PASSWORD ===================== -->
                <Border Style="{StaticResource S.Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="ACCOUNT PASSWORD (USED BY EVERY TOOL)"
                                   Style="{StaticResource T.Section}" />
                        <Rectangle Style="{StaticResource S.Rule}" />

                        <TextBlock Style="{StaticResource T.Mini}" Margin="0,0,0,12">
                            The password each tool sets on the accounts it creates. It is handed to the
                            tool at run time and never written into the tool's own code. Leave it empty
                            and every account gets its own random password, printed in the live log.
                        </TextBlock>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="44" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Account Password :"
                                       Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                            <Grid Grid.Row="0" Grid.Column="1" MaxWidth="520" HorizontalAlignment="Left">
                                <TextBox x:Name="AccountPassBox" Style="{StaticResource S.TextBox}"
                                         FontFamily="{StaticResource F.Mono}" />
                                <Border x:Name="AccountPassMask"
                                        Background="{StaticResource B.Field}"
                                        BorderBrush="{StaticResource B.Line}" BorderThickness="1"
                                        CornerRadius="10" Padding="13,0">
                                    <TextBlock Text="(empty — random password per account)"
                                               VerticalAlignment="Center"
                                               FontFamily="{StaticResource F.Mono}"
                                               FontSize="12.5"
                                               Foreground="{StaticResource B.TextMuted}" />
                                </Border>
                            </Grid>
                            <Button Grid.Row="0" Grid.Column="2"
                                    x:Name="AccountPassEye"
                                    Content="👁"
                                    Style="{StaticResource S.GhostButton}"
                                    Margin="8,0,0,0"
                                    Click="OnToggleAccountPass"
                                    ToolTip="Show / hide the account password" />

                            <TextBlock Grid.Row="1" Grid.Column="1"
                                       Text="Reaches the tools as ACCOUNT_PASSWORD. Applies to all four tools."
                                       Style="{StaticResource T.Mini}" Margin="2,6,0,0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===================== PROXY POOL ===================== -->
                <Border Style="{StaticResource S.Card}">
                    <StackPanel>
                        <TextBlock Text="PROXY LIST (SHARED BY EVERY TOOL)" Style="{StaticResource T.Section}" />
                        <Rectangle Style="{StaticResource S.Rule}" />

                        <TextBlock Style="{StaticResource T.Mini}" TextWrapping="Wrap" Margin="0,0,0,10"
                                   Text="One proxy per line — host:port, or user:pass@host:port (http:// and socks5:// also accepted; blank lines and # comments ignored). The tools read this list and pick a live entry; each tool panel keeps its own PROXY ON/OFF switch." />

                        <Border Background="{StaticResource B.Field}" BorderBrush="{StaticResource B.Line}"
                                BorderThickness="1" CornerRadius="10" Padding="13,10">
                            <TextBox x:Name="ProxyPoolBox"
                                     AcceptsReturn="True" AcceptsTab="False"
                                     TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     Height="150"
                                     FontFamily="{StaticResource F.Mono}" FontSize="12"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource B.Text}" />
                        </Border>

                        <WrapPanel Margin="0,12,0,0">
                            <Button x:Name="ProxyGitHubButton" Content="⬇  GITHUB PROXIES"
                                    Style="{StaticResource S.GhostButton}" Padding="14,7"
                                    Click="OnFetchGitHubProxies"
                                    ToolTip="Download the public GitHub proxy lists into the box above" />
                            <Button x:Name="ProxyTestButton" Content="✔  TEST &amp; REMOVE DEAD"
                                    Style="{StaticResource S.GhostButton}" Padding="14,7" Margin="8,0,0,0"
                                    Click="OnTestProxies"
                                    ToolTip="Test every proxy in the box and delete the ones that do not answer" />
                            <Button x:Name="ProxyReloadButton" Content="↺  RELOAD FILE"
                                    Style="{StaticResource S.GhostButton}" Padding="14,7" Margin="8,0,0,0"
                                    Click="OnReloadProxyPool"
                                    ToolTip="Discard the box and re-read proxies.txt from disk" />
                        </WrapPanel>

                        <TextBlock x:Name="ProxyPoolStatus" Style="{StaticResource T.Mini}"
                                   TextWrapping="Wrap" Margin="2,10,0,0" />
                        <TextBlock x:Name="ProxyPoolPath" Style="{StaticResource T.Mini}"
                                   TextWrapping="Wrap" Margin="2,4,0,0" Opacity="0.7" />
                    </StackPanel>
                </Border>

                <!-- ===================== UPDATES ===================== -->
                <Border Style="{StaticResource S.Card}">
                    <StackPanel>
                        <TextBlock Text="UPDATES  ·  GITHUB RELEASES" Style="{StaticResource T.Section}" />
                        <Rectangle Style="{StaticResource S.Rule}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Release Feed :"
                                       VerticalAlignment="Center" />
                            <Border Grid.Row="0" Grid.Column="1" Background="{StaticResource B.Field}"
                                    BorderBrush="{StaticResource B.Line}" BorderThickness="1"
                                    CornerRadius="10" Padding="13,0" Height="38">
                                <TextBox x:Name="UpdateUrlBox"
                                         FontFamily="{StaticResource F.Mono}" FontSize="12"
                                         VerticalContentAlignment="Center"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="{StaticResource B.Text}" />
                            </Border>

                            <TextBlock Grid.Row="1" Grid.Column="1"
                                       Text="GitHub release feed is built in. Updates are checked after licence validation; type off to disable or github://owner/repo to use another release repository."
                                       Style="{StaticResource T.Mini}" Margin="2,6,0,0" TextWrapping="Wrap" />

                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="2,14,0,0">
                                <Button x:Name="UpdateCheckButton" Content="⟳  CHECK NOW"
                                        Style="{StaticResource S.GhostButton}" Padding="14,7"
                                        Click="OnCheckForUpdates" />
                                <Button x:Name="UpdateInstallButton" Content="⬇  INSTALL UPDATE"
                                        Style="{StaticResource S.GhostButton}" Padding="14,7" Margin="8,0,0,0"
                                        IsEnabled="False" Click="OnInstallUpdate" />
                                <Button x:Name="UpdateRestoreButton" Content="↺  RESTORE PREVIOUS"
                                        Style="{StaticResource S.GhostButton}" Padding="14,7" Margin="8,0,0,0"
                                        Click="OnRestorePrevious"
                                        ToolTip="Copy back the files the last update replaced" />
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="UpdateStatus" Style="{StaticResource T.Mini}"
                                   TextWrapping="Wrap" Margin="2,12,0,0" />
                        <TextBlock x:Name="UpdateDetail" Style="{StaticResource T.Mini}"
                                   TextWrapping="Wrap" Margin="2,4,0,0" Opacity="0.75" />

                        <Border x:Name="UpdateNoteBox" Visibility="Collapsed" Margin="0,10,0,0"
                                Background="{StaticResource B.Field}" BorderBrush="{StaticResource B.Line}"
                                BorderThickness="1" CornerRadius="8" Padding="12,8">
                            <TextBlock x:Name="UpdateNotes" Style="{StaticResource T.Mini}" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ===================== PROBLEMS ===================== -->
                <Border x:Name="IssuePanel" Visibility="Collapsed"
                        CornerRadius="12" Padding="16,14" Margin="0,0,0,16"
                        Background="#22F87171" BorderBrush="#55F87171" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Fix these before saving:"
                                   FontFamily="Segoe UI Semibold" FontSize="12.5"
                                   Foreground="#FFFCA5A5" Margin="0,0,0,8" />
                        <ItemsControl x:Name="IssueList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="12"
                                               Foreground="#FFFCA5A5" Margin="0,2,0,0" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ===================== SAVE ===================== -->
                <Grid Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="Toast" Visibility="Collapsed"
                            CornerRadius="10" Padding="14,10"
                            Background="#2234D399" BorderBrush="#5534D399" BorderThickness="1"
                            HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock x:Name="ToastText" FontSize="12.5" Foreground="#FF9CF0D0" />
                    </Border>

                    <Button Grid.Column="1" x:Name="SaveButton"
                            Content="💾  SAVE GLOBAL SETTINGS"
                            Style="{StaticResource S.PrimaryButton}"
                            Width="270"
                            Click="OnSave" />
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
