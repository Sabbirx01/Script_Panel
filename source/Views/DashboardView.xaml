<UserControl x:Class="AISuitePanel.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:AISuitePanel"
             FontFamily="Segoe UI">

    <UserControl.Resources>

        <!-- One dashboard card -->
        <Style x:Key="ToolCard" TargetType="Border" BasedOn="{StaticResource S.Card}">
            <Setter Property="Margin" Value="0,0,18,18" />
            <Setter Property="Padding" Value="22,20,22,22" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{Binding Accent}" />
                    <Setter Property="Background" Value="{StaticResource B.CardSheen}" />
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="{Binding AccentColor}" BlurRadius="30"
                                              ShadowDepth="0" Opacity="0.30" />
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Full width accent button used to open a tool -->
        <Style x:Key="OpenButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FF06131C" />
            <Setter Property="FontFamily" Value="Segoe UI Semibold" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{Binding AccentGradient}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="bd" CornerRadius="11" Background="{TemplateBinding Background}">
                                <Border.Effect>
                                    <DropShadowEffect Color="{Binding AccentColor}" BlurRadius="22"
                                                      ShadowDepth="0" Opacity="0.35" />
                                </Border.Effect>
                            </Border>
                            <Border x:Name="sheen" CornerRadius="11" Background="#FFFFFFFF"
                                    Opacity="0" IsHitTestVisible="False" />
                            <ContentPresenter Margin="16,0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="sheen" Property="Opacity" Value="0.16" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="sheen" Property="Opacity" Value="0.02" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The "Saved Cookies: N" counter -->
        <Style x:Key="CookieCount" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource F.Mono}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource B.AccentA}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasCookies}" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource B.TextMuted}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Licence chip on a tool card: shows the box's own key, or the shape a
             key for this box has. Green once the box is licensed. -->
        <Style x:Key="LicenceChip" TargetType="Border">
            <Setter Property="Margin" Value="0,9,0,0" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#22FFFFFF" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLicensed}" Value="True">
                    <Setter Property="Background" Value="#1A34D399" />
                    <Setter Property="BorderBrush" Value="#5534D399" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LicenceKeyText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource F.Mono}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource B.TextMuted}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLicensed}" Value="True">
                    <Setter Property="Foreground" Value="#FF9CF0D0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LicenceDetailText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource B.TextDim}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLicensed}" Value="True">
                    <Setter Property="Foreground" Value="#FF6EE7B7" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================== HEADER ============================== -->
        <Grid Grid.Row="0" Margin="34,26,34,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="{x:Static core:Branding.DashboardTitle}"
                           Style="{StaticResource T.Title}" FontSize="24" />
                <TextBlock x:Name="SubLine" Style="{StaticResource T.Sub}" Margin="0,8,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border CornerRadius="11" Padding="13,8"
                        Background="#2234D399" BorderBrush="#5534D399" BorderThickness="1"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource B.Ok}" VerticalAlignment="Center" />
                        <TextBlock x:Name="KeyChip" Margin="8,0,0,0"
                                   FontFamily="{StaticResource F.Mono}" FontSize="11.5"
                                   Foreground="#FF9CF0D0" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Button x:Name="SettingsButton"
                        Content="⚙️  SETTING"
                        Style="{StaticResource S.GhostButton}"
                        Margin="12,0,0,0"
                        Click="OnOpenSettings"
                        ToolTip="Global mail settings" />

                <Button x:Name="ResetLicenseButton"
                        Content="RESET LICENSE"
                        Style="{StaticResource S.GhostButton}"
                        Margin="8,0,0,0"
                        Click="OnResetLicense" />
            </StackPanel>
        </Grid>

        <Border x:Name="UpdateBanner" Grid.Row="1" Visibility="Collapsed"
                Margin="34,22,34,0" Padding="16,13"
                CornerRadius="16" Background="#1934D399" BorderBrush="#6634D399" BorderThickness="1"
                VerticalAlignment="Top" Panel.ZIndex="3">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="NEW UPDATE AVAILABLE" FontFamily="Segoe UI Semibold" FontSize="12"
                               Foreground="#FF9CF0D0" />
                    <TextBlock x:Name="UpdateBannerText" Margin="0,4,0,0" FontSize="13"
                               Foreground="{StaticResource B.Text}" />
                    <TextBlock x:Name="UpdateBannerNote" Margin="0,4,0,0" Style="{StaticResource T.Mini}"
                               MaxWidth="650" />
                </StackPanel>
                <Button Grid.Column="1" Content="REVIEW UPDATE  ›" Style="{StaticResource S.GhostButton}"
                        Padding="15,7" Margin="18,0,0,0" VerticalAlignment="Center"
                        Click="OnOpenUpdateSettings" />
            </Grid>
        </Border>

        <!-- ============================== TOOL GRID ============================== -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,0">
            <ItemsControl x:Name="ToolList" Margin="34,24,16,16">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ToolCard}" MouseLeftButtonUp="OnCardClick">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- header: glyph + name + cookie count -->
                                <StackPanel Grid.Row="0" Orientation="Horizontal">
                                    <Border Width="56" Height="56" CornerRadius="16"
                                            Background="{Binding AccentGradient}">
                                        <Path Data="{Binding Icon}"
                                              Fill="#FF06131C"
                                              Stretch="Uniform"
                                              Margin="14" />
                                    </Border>

                                    <StackPanel Margin="15,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   FontFamily="Segoe UI Semibold" FontSize="18"
                                                   Foreground="{StaticResource B.Text}" />

                                        <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                            <TextBlock Text="Saved Cookies:"
                                                       FontSize="12"
                                                       Foreground="{StaticResource B.TextMuted}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding CookieCountLabel}"
                                                       Style="{StaticResource CookieCount}"
                                                       Margin="6,0,0,0" />
                                        </StackPanel>

                                        <!-- this box's own licence: which key opens it,
                                             and how long is left -->
                                        <Border Style="{StaticResource LicenceChip}"
                                                ToolTip="This box needs its own licence key.">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding LicenceHeadline}"
                                                           Style="{StaticResource LicenceKeyText}" />
                                                <TextBlock Text="  ·  "
                                                           FontSize="11" VerticalAlignment="Center"
                                                           Foreground="{StaticResource B.TextMuted}" />
                                                <TextBlock Text="{Binding LicenceDetail}"
                                                           Style="{StaticResource LicenceDetailText}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <!-- open -->
                                <Button Grid.Row="2" x:Name="OpenToolButton"
                                        Style="{StaticResource OpenButton}"
                                        Content="{Binding OpenLabel}"
                                        Margin="0,22,0,0"
                                        Click="OnOpenTool" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
