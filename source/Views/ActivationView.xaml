<UserControl x:Class="AISuitePanel.Views.ActivationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:AISuitePanel"
             FontFamily="Segoe UI">

    <Grid>
        <!-- soft glow behind the card -->
        <Ellipse x:Name="BadgeGlow" Width="520" Height="520"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#5522D3EE" Offset="0" />
                    <GradientStop Color="#0022D3EE" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Border x:Name="Badge"
                Width="540"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Style="{StaticResource S.Card}"
                Padding="38,34,38,34"
                BorderBrush="#6622D3EE">
            <StackPanel>

                <!-- badge -->
                <Border Width="74" Height="74" CornerRadius="22"
                        HorizontalAlignment="Center"
                        Background="#FF0F1B2E"
                        BorderBrush="#6622D3EE" BorderThickness="1">
                    <Viewbox Margin="17">
                        <Canvas Width="24" Height="24">
                            <Path x:Name="LockShackle"
                                  Data="M7.6,10.6 V8.4 A4.4,4.4 0 0 1 16.4,8.4 V10.6"
                                  Stroke="#FF22D3EE" StrokeThickness="2.1"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Path x:Name="LockBody"
                                  Data="M5.2,10.4 H18.8 A2.2,2.2 0 0 1 21,12.6 V19 A2.2,2.2 0 0 1 18.8,21.2 H5.2 A2.2,2.2 0 0 1 3,19 V12.6 A2.2,2.2 0 0 1 5.2,10.4 Z"
                                  Fill="#FF22D3EE" />
                            <Ellipse Canvas.Left="11" Canvas.Top="14.4" Width="2" Height="2" Fill="#FF06131C" />
                        </Canvas>
                    </Viewbox>
                </Border>

                <TextBlock Text="{x:Static core:Branding.ActivationTitle}"
                           Style="{StaticResource T.Title}"
                           FontSize="20"
                           HorizontalAlignment="Center"
                           Margin="0,22,0,0" />

                <TextBlock Text="{x:Static core:Branding.ActivationSubtitle}"
                           Style="{StaticResource T.Sub}"
                           FontSize="12.5"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0" />

                <Rectangle Style="{StaticResource S.Rule}" Margin="0,24,0,22" />

                <!-- key -->
                <TextBlock Text="Enter License Key:" Style="{StaticResource T.Label}" />

                <TextBox x:Name="KeyBox"
                         Style="{StaticResource S.TextBox}"
                         FontFamily="{StaticResource F.Mono}"
                         FontSize="17"
                         Height="52"
                         CharacterCasing="Upper"
                          TextChanged="OnKeyTextChanged"
                         PreviewKeyDown="OnKeyKeyDown"
                         GotKeyboardFocus="OnKeyFocused" />

                <Button x:Name="ActivateButton"
                        Style="{StaticResource S.PrimaryButton}"
                        Margin="0,18,0,0"
                        IsEnabled="False"
                        Click="OnActivate">
                    <TextBlock x:Name="ActivateText"
                               Text="🚀  ACTIVATE SOFTWARE"
                               FontFamily="Segoe UI Semibold" FontSize="14" />
                </Button>

                <!-- status -->
                <Border x:Name="StatusPill"
                        CornerRadius="10"
                        Padding="13,8"
                        Margin="0,16,0,0"
                        Background="#FF131C2F"
                        BorderBrush="{StaticResource B.Line}"
                        BorderThickness="1">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="7" Height="7"
                                 Fill="{StaticResource B.TextMuted}" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusLabel"
                                   Text="Status: License Unverified"
                                   Margin="8,0,0,0"
                                   FontSize="12"
                                   Foreground="{StaticResource B.TextDim}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <TextBlock Text="{x:Static core:Branding.ActivationHint}"
                           Style="{StaticResource T.Hint}"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,12,0,0" />

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
