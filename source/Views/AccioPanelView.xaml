<UserControl x:Class="AISuitePanel.Views.AccioPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <Style x:Key="QtyBox" TargetType="TextBox" BasedOn="{StaticResource S.TextBox}">
            <Setter Property="Width" Value="100" />
            <Setter Property="Height" Value="38" />
            <Setter Property="FontFamily" Value="{StaticResource F.Mono}" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>

        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource B.Card}" />
            <Setter Property="BorderBrush" Value="{StaticResource B.Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>

        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontFamily" Value="Segoe UI Semibold" />
            <Setter Property="Foreground" Value="{StaticResource B.TextMuted}" />
        </Style>

        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontFamily" Value="Segoe UI Semibold" />
            <Setter Property="Foreground" Value="{StaticResource B.Text}" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <Style x:Key="TabBtn" TargetType="Button" BasedOn="{StaticResource S.GhostButton}">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>

        <Style x:Key="HeadText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontFamily" Value="Segoe UI Semibold" />
            <Setter Property="Foreground" Value="{StaticResource B.TextMuted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- column widths repeated for header + every row -->
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,4" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================== BACK ============================== -->
        <Button Grid.Row="0" Content="⬅  BACK TO DASHBOARD"
                Style="{StaticResource S.GhostButton}"
                HorizontalAlignment="Left"
                Margin="34,24,0,0"
                Click="OnBack" />

        <!-- ============================== TITLE ============================== -->
        <StackPanel Grid.Row="1" Margin="34,16,34,0">
            <TextBlock x:Name="TitleText" Style="{StaticResource T.Title}" FontSize="21" />
            <TextBlock x:Name="SubTitle" Style="{StaticResource T.Sub}" FontSize="12.5" Margin="0,8,0,0" />
        </StackPanel>

        <!-- ============================== BODY ============================== -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="34,18,22,26">

                <!-- ============== STAT CARDS (Accio.exe GUI parity) ============== -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource StatCard}">
                        <StackPanel>
                            <TextBlock Text="TOTAL ACCOUNTS" Style="{StaticResource StatLabel}" />
                            <TextBlock x:Name="StatTotal" Text="0" Style="{StaticResource StatValue}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource StatCard}">
                        <StackPanel>
                            <TextBlock Text="ACTIVE TODAY" Style="{StaticResource StatLabel}" />
                            <TextBlock x:Name="StatActiveToday" Text="0"
                                       Style="{StaticResource StatValue}"
                                       Foreground="{StaticResource B.Ok}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource StatCard}">
                        <StackPanel>
                            <TextBlock Text="LAST RUN" Style="{StaticResource StatLabel}" />
                            <TextBlock x:Name="StatLastRun" Text="—"
                                       Style="{StaticResource StatValue}"
                                       FontSize="14"
                                       Foreground="{StaticResource B.AccentB}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Style="{StaticResource StatCard}" Margin="0">
                        <StackPanel>
                            <TextBlock Text="DAILY CAP / POOL" Style="{StaticResource StatLabel}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="StatDailyCap" Text="∞  (no cap)"
                                           Style="{StaticResource StatValue}"
                                           Foreground="{StaticResource B.Ok}" />
                                <TextBlock x:Name="StatPool" Text="  ·  6"
                                           Style="{StaticResource StatValue}"
                                           FontSize="14"
                                           Foreground="#FFFBBF24" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ============== TAB BAR ============== -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <Button x:Name="TabDashBtn"  Content="📊 Dashboard" Style="{StaticResource TabBtn}" Click="OnTabDashboard" />
                    <Button x:Name="TabCreateBtn" Content="▶ Create"     Style="{StaticResource TabBtn}" Click="OnTabCreate" />
                    <Button x:Name="TabLoginBtn"  Content="🔓 Login"      Style="{StaticResource TabBtn}" Click="OnTabLogin" />
                    <Button x:Name="TabSetBtn"    Content="⚙ Settings"   Style="{StaticResource TabBtn}" Click="OnTabSettings" />
                </StackPanel>

                <!-- ============== TAB: DASHBOARD ============== -->
                <Border x:Name="TabDashboard" Style="{StaticResource S.Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="ACCOUNT TABLE" Style="{StaticResource T.Section}" />
                        <Rectangle Style="{StaticResource S.Rule}" />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="62" />
                                <ColumnDefinition Width="78" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="#"        Style="{StaticResource HeadText}" />
                            <TextBlock Grid.Column="1" Text="EMAIL"    Style="{StaticResource HeadText}" />
                            <TextBlock Grid.Column="2" Text="MODE"     Style="{StaticResource HeadText}" />
                            <TextBlock Grid.Column="3" Text="STATUS"   Style="{StaticResource HeadText}" />
                            <TextBlock Grid.Column="4" Text="COOKIES"  Style="{StaticResource HeadText}" />
                        </Grid>
                        <Rectangle Height="1" Fill="{StaticResource B.Line}" />

                        <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                            <ItemsControl x:Name="AcctList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Style="{StaticResource Row}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="62" />
                                                <ColumnDefinition Width="78" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding IdLabel}"
                                                       FontFamily="{StaticResource F.Mono}" FontSize="12"
                                                       Foreground="{StaticResource B.TextDim}"
                                                       VerticalAlignment="Center" />

                                            <TextBlock Grid.Column="1" Text="{Binding EmailUsed}"
                                                       FontFamily="{StaticResource F.Mono}" FontSize="12"
                                                       Foreground="{StaticResource B.Text}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />

                                            <TextBlock Grid.Column="2" Text="{Binding SourceRef}"
                                                       FontSize="11.5"
                                                       Foreground="{StaticResource B.TextDim}"
                                                       VerticalAlignment="Center" />

                                            <TextBlock Grid.Column="3" Text="{Binding StatusLabel}"
                                                       FontSize="11.5" FontFamily="Segoe UI Semibold"
                                                       Foreground="{Binding StatusColor}"
                                                       VerticalAlignment="Center" />

                                            <TextBlock Grid.Column="4" Text="{Binding CookieLabel}"
                                                       FontSize="11.5"
                                                       Foreground="{StaticResource B.TextDim}"
                                                       VerticalAlignment="Center" />

                                            <Button Grid.Column="5" Content="View"
                                                    Style="{StaticResource S.GhostButton}"
                                                    Height="28" FontSize="11"
                                                    Margin="0,0,6,0"
                                                    Click="OnViewCookie" />

                                            <Button Grid.Column="6" Content="Export"
                                                    Style="{StaticResource S.GhostButton}"
                                                    Height="28" FontSize="11"
                                                    Margin="6,0,0,0"
                                                    Click="OnExportCookie" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock x:Name="AcctEmpty" Text="No accounts yet. Use the Create tab to make one."
                                   Style="{StaticResource T.Mini}" Margin="2,10,0,0" />
                    </StackPanel>
                </Border>

                <!-- ============== TAB: CREATE ============== -->
                <Border x:Name="TabCreate" Style="{StaticResource S.Card}" Margin="0,0,0,16" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="CREATE ACCOUNT" Style="{StaticResource T.Section}" />
                        <Rectangle Style="{StaticResource S.Rule}" />

                        <!-- Mail source: read-only summary of Global Settings, where the
                             values actually live. Accio does NOT keep its own mailbox. -->
                        <TextBlock Style="{StaticResource T.Label}" Margin="0,14,0,0">📧 GLOBAL MAIL  (from Global Settings — the values the radio buttons below use)</TextBlock>
                        <Border Background="#FF0B1220" BorderBrush="{StaticResource B.Line}" BorderThickness="1"
                                CornerRadius="8" Padding="14,10" Margin="0,6,0,0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Gmail pool     :" Style="{StaticResource T.Mini}"
                                               Foreground="{StaticResource B.TextMuted}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" x:Name="GmailPoolSummary" Style="{StaticResource T.Mini}"
                                               Foreground="{StaticResource B.Text}" VerticalAlignment="Center"
                                               FontFamily="{StaticResource F.Mono}" TextWrapping="Wrap" />
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Custom domain  :" Style="{StaticResource T.Mini}"
                                               Foreground="{StaticResource B.TextMuted}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" x:Name="DomainSummary" Style="{StaticResource T.Mini}"
                                               Foreground="{StaticResource B.Text}" VerticalAlignment="Center"
                                               FontFamily="{StaticResource F.Mono}" TextWrapping="Wrap" />
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Custom mail    :" Style="{StaticResource T.Mini}"
                                               Foreground="{StaticResource B.TextMuted}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" x:Name="CustomMailSummary" Style="{StaticResource T.Mini}"
                                               Foreground="{StaticResource B.Text}" VerticalAlignment="Center"
                                               FontFamily="{StaticResource F.Mono}" TextWrapping="Wrap" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource T.Label}" Margin="0,18,0,6">✉️ MAIL MODE FOR THIS RUN  (override the auto-pick if you want)</TextBlock>
                        <RadioButton x:Name="ModePool"   GroupName="Mode" Style="{StaticResource S.RadioButton}" Content="1) Gmail Pool (rotate dots from Global Settings)" IsChecked="True" />
                        <RadioButton x:Name="ModeTemp"   GroupName="Mode" Margin="0,8,0,0" Style="{StaticResource S.RadioButton}" Content="2) Auto (Temp Mail / 1secmail)" />
                        <RadioButton x:Name="ModeDomain" GroupName="Mode" Margin="0,8,0,0" Style="{StaticResource S.RadioButton}" Content="3) Custom Domain (Cloudflare catch-all from Global Settings)" />
                        <RadioButton x:Name="ModeCustom" GroupName="Mode" Margin="0,8,0,0" Style="{StaticResource S.RadioButton}" Content="4) Custom Mail (one Gmail + app password, used once)" />
                        <RadioButton x:Name="ModeSemi"   GroupName="Mode" Margin="0,8,0,0" Style="{StaticResource S.RadioButton}" Content="5) Semi Automation (manual OTP)" />
                        <RadioButton x:Name="ModeNoPx"   GroupName="Mode" Margin="0,8,0,0" Style="{StaticResource S.RadioButton}" Content="6) No Proxy (direct connection)" />
                        <RadioButton x:Name="ModeOutlook" GroupName="Mode" Margin="0,8,0,0" Style="{StaticResource S.RadioButton}"
                                     Content="7) Token Mail (Outlook pool — rotates, OTP read from the inbox)" />
                        <RadioButton x:Name="ModeTest"   GroupName="Mode" Margin="0,8,0,0" Style="{StaticResource S.RadioButton}" Content="7) Test (no real signup — UI demo only)" />
                        <TextBlock x:Name="MailModeHint" Style="{StaticResource T.Mini}" Margin="2,8,0,0" TextWrapping="Wrap" />

                        <!-- Accio-only extra: create.py's x-trick. No other tool has it,
                             so this check box exists on this panel and nowhere else. -->
                        <Border Background="#FF0B1220" BorderBrush="{StaticResource B.Line}" BorderThickness="1"
                                CornerRadius="8" Padding="14,10" Margin="0,14,0,0">
                            <StackPanel>
                                <CheckBox x:Name="XTrickCheck"
                                          Style="{StaticResource S.CheckBox}"
                                          Content="🧩  x-trick: ON  (type &quot;&lt;address&gt;x&quot;, walk the Change step, drop the x)"
                                          Checked="OnXTrickChanged"
                                          Unchecked="OnXTrickChanged" />
                                <TextBlock x:Name="XTrickHint" Style="{StaticResource T.Mini}" Margin="24,6,0,0"
                                           TextWrapping="Wrap"
                                           Text="Accio-only step. Turn it off only if the probe page starts failing." />
                                <Grid Margin="24,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="70" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="CAPTCHA wait (s):" Style="{StaticResource T.Mini}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBox Grid.Column="1" x:Name="CaptchaWaitBox" Text="5" Style="{StaticResource QtyBox}" PreviewTextInput="OnDecimalOnly" />
                                    <TextBlock Grid.Column="2" Text="Change wait (s):" Style="{StaticResource T.Mini}" VerticalAlignment="Center" Margin="14,0,8,0" />
                                    <TextBox Grid.Column="3" x:Name="XTrickWaitBox" Text="5" Style="{StaticResource QtyBox}" PreviewTextInput="OnDecimalOnly" />
                                    <TextBlock Grid.Column="4" Text="Action delay (ms):" Style="{StaticResource T.Mini}" VerticalAlignment="Center" Margin="14,0,8,0" />
                                    <TextBox Grid.Column="5" x:Name="ActionDelayBox" Text="0" Style="{StaticResource QtyBox}" PreviewTextInput="OnDigitsOnly" />
                                </Grid>
                                <TextBlock Style="{StaticResource T.Mini}" Margin="24,6,0,0"
                                           Text="After you solve CAPTCHA, Accio waits the configured time; when the verification input/Change state is visible, it waits again, removes x, then clicks Continue/Send code." TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- proxy override: ON/OFF switch that beats the per-mode setting -->
                        <Border Background="#FF0B1220" BorderBrush="{StaticResource B.Line}" BorderThickness="1"
                                CornerRadius="8" Padding="14,10" Margin="0,16,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="🔌  PROXY:"
                                           Style="{StaticResource T.Label}"
                                           VerticalAlignment="Center" Margin="0,0,12,0" />

                                <ToggleButton x:Name="ProxyToggle" Grid.Column="1"
                                              Content="ON"
                                              Width="80"
                                              Checked="OnProxyToggleChanged"
                                              Unchecked="OnProxyToggleChanged"
                                              ToolTip="Override the per-mode proxy setting." />

                                 <TextBlock x:Name="ProxyHint" Grid.Column="2"
                                            Margin="14,0,0,0"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource T.Mini}"
                                            Text="ON → use configured proxies (.env or _fallback_proxies.txt)." />
                             </Grid>
                         </Border>

                        <!-- SIGNUP URL - the page every account of this run is created
                             on. Handed to the tool as its url argument, so the
                             operator's own link (their landing page, a
                             referral/campaign link, another locale) is used instead
                             of the built-in default. Saved per tool in
                             tool-settings.json. -->
                        <Border Background="#FF0B1220" BorderBrush="{StaticResource B.Line}" BorderThickness="1"
                                CornerRadius="8" Padding="14,10" Margin="0,12,0,0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="🌐  SIGNUP URL:"
                                               Style="{StaticResource T.Label}"
                                               VerticalAlignment="Center" Margin="0,0,12,0" />

                                    <TextBox Grid.Column="1" x:Name="CreateUrlBox"
                                             Style="{StaticResource S.TextBox}"
                                             FontFamily="{StaticResource F.Mono}"
                                             LostFocus="OnCreateUrlChanged"
                                             ToolTip="Where accounts of the next run are created. Any http(s) URL; empty = the tool's default."
                                             Text="https://www.accio.com/login" />
                                </Grid>
                                <TextBlock x:Name="CreateUrlHint" Style="{StaticResource T.Mini}" Margin="0,6,0,0"
                                           TextWrapping="Wrap"
                                           Text="Passed to the create run as --url. Empty = the tool's default signup page." />
                            </StackPanel>
                        </Border>


                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Count :"
                                       Style="{StaticResource T.Label}"
                                       VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBox Grid.Column="1" x:Name="CountBox" Text="1" Style="{StaticResource QtyBox}"
                                     PreviewTextInput="OnDigitsOnly" />

                            <Button Grid.Column="2" x:Name="CountUnlimitedBtn" Content="∞"
                                    Style="{StaticResource S.GhostButton}"
                                    Width="40" Margin="6,0,0,0"
                                    ToolTip="Toggle unlimited. Removes the per-run cap; runs as many as the pool yields until ⏹ STOP or daily limit."
                                    Click="OnCountUnlimited" />

                            <Button Grid.Column="3" x:Name="RunBtn" Content="▶  RUN"
                                    Style="{StaticResource S.PrimaryButton}"
                                    Width="120" Margin="14,0,0,0"
                                    Click="OnRun" />
                            <Button Grid.Column="4" x:Name="StopBtn" Content="⏹  STOP"
                                    Style="{StaticResource S.GhostButton}"
                                    Width="100" Margin="8,0,0,0"
                                    HorizontalAlignment="Left"
                                    Visibility="Collapsed"
                                    Click="OnStop" />

                            <Button Grid.Column="5" x:Name="PreflightBtn" Content="🔍  PRE-FLIGHT"
                                    Style="{StaticResource S.GhostButton}"
                                    Width="140" Margin="14,0,0,0"
                                    HorizontalAlignment="Left"
                                    Click="OnPreflight" />
                        </Grid>

                        <!-- daily / batch cap settings -->
                        <Border Background="#FF0B1220" BorderBrush="{StaticResource B.Line}" BorderThickness="1"
                                CornerRadius="8" Padding="14,10" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource T.Label}" Margin="0,0,0,6">
                                    📊 BATCH LIMITS  (panel-side, not Accio's internal cap)
                                </TextBlock>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="Max per run :"
                                               Style="{StaticResource T.Mini}"
                                               VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBox x:Name="MaxPerRunBox" Grid.Column="1" Text="50"
                                             Style="{StaticResource QtyBox}" Width="80"
                                             PreviewTextInput="OnDigitsOnly" />

                                    <TextBlock Grid.Column="2" Text="Max per day :"
                                               Style="{StaticResource T.Mini}"
                                               VerticalAlignment="Center" Margin="20,0,8,0" />
                                    <TextBox x:Name="MaxPerDayBox" Grid.Column="3" Text="9999"
                                             Style="{StaticResource QtyBox}" Width="80"
                                             HorizontalAlignment="Left"
                                             PreviewTextInput="OnDigitsOnly" />
                                </Grid>
                                <TextBlock x:Name="BatchHint" Style="{StaticResource T.Mini}"
                                           Margin="2,8,0,0"
                                           Text="∞ No cap (9999/day, 50/run). Lower the numbers above only if you want a hard cap." />
                            </StackPanel>
                        </Border>

                        <!-- progress -->
                        <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,18,0,0">
                            <TextBlock x:Name="ProgressText" Text="00 / 00"
                                       FontFamily="{StaticResource F.Mono}" FontSize="12"
                                       Foreground="{StaticResource B.TextDim}" />
                            <ProgressBar x:Name="Progress" Height="8" Margin="0,8,0,0"
                                         Minimum="0" Maximum="100" Value="0"
                                         Background="#FF0B1220"
                                         Foreground="{StaticResource B.AccentA}"
                                         BorderThickness="0" />
                        </StackPanel>

                        <!-- live log (mirrors Accio's subprocess stdout) -->
                        <Grid Margin="0,18,0,6">
                            <TextBlock Text="LIVE LOG  (create.py stdout)" Style="{StaticResource T.Label}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="⤡  SMALLER" Style="{StaticResource S.GhostButton}"
                                        Height="28" FontSize="11"
                                        Click="OnLogSmaller"
                                        ToolTip="Shrink the live log" />
                                <Button Content="⤢  BIGGER" Style="{StaticResource S.GhostButton}"
                                        Height="28" FontSize="11" Margin="8,0,0,0"
                                        Click="OnLogBigger"
                                        ToolTip="Grow the live log (or drag the grip under it)" />
                                <Button Content="CLEAR" Style="{StaticResource S.GhostButton}"
                                        Height="28" FontSize="11" Margin="8,0,0,0"
                                        Click="OnClearLiveLog" />
                                <Button Content="🖹  COPY LOG" Style="{StaticResource S.GhostButton}"
                                        Height="28" FontSize="11" Margin="8,0,0,0"
                                        Click="OnCopyLiveLog" />
                            </StackPanel>
                        </Grid>
                        <!-- Fixed height rather than MaxHeight so the box can be dragged
                             both ways; ScrollToEnd on every append keeps the newest
                             line visible instead of making the user chase the bar. -->
                        <Border x:Name="LogHost" Background="#FF06080C" BorderBrush="{StaticResource B.Line}"
                                BorderThickness="1" CornerRadius="8" Padding="12,8"
                                Height="240" MinHeight="90">
                            <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <TextBlock x:Name="LogBox"
                                           FontFamily="{StaticResource F.Mono}" FontSize="11.5"
                                           Foreground="{StaticResource B.Text}" TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Border>
                        <Thumb x:Name="LogResizeGrip" Height="10" Margin="0,3,0,0"
                               Cursor="SizeNS" Opacity="0.6"
                               ToolTip="Drag up or down to resize the live log"
                               DragDelta="OnLogResize">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Border Background="Transparent" Padding="0,4">
                                        <Rectangle Height="2" RadiusX="1" RadiusY="1"
                                                   Fill="{StaticResource B.LineStrong}" />
                                    </Border>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </StackPanel>
                </Border>

                <!-- ============== TAB: LOGIN (cookie-based) ============== -->
                <Border x:Name="TabLogin" Style="{StaticResource S.Card}" Margin="0,0,0,16" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="LOGIN ACCOUNT (COOKIE REPLAY)" Style="{StaticResource T.Section}" />
                        <Rectangle Style="{StaticResource S.Rule}" />

                        <TextBlock x:Name="LoginCookieCount"
                                   Text="Accounts with cookies: 0  /  Total: 0"
                                   FontSize="13.5" Foreground="{StaticResource B.Text}" />

                        <!-- top action bar -->
                        <Grid Margin="0,12,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" x:Name="LoginSelAllBtn" Content="☑  SELECT ALL"
                                    Style="{StaticResource S.GhostButton}" Width="120"
                                    Click="OnLoginSelectAll" />
                            <Button Grid.Column="1" x:Name="LoginClearBtn" Content="☐  CLEAR"
                                    Style="{StaticResource S.GhostButton}" Width="100" Margin="8,0,0,0"
                                    Click="OnLoginSelectNone" />
                            <Button Grid.Column="2" x:Name="LoginVerifyBtn" Content="🔑  VERIFY LOGIN"
                                    Style="{StaticResource S.PrimaryButton}" Width="160" Margin="16,0,0,0"
                                    Click="OnLoginVerifySelected" />
                        </Grid>

                        <!-- proxy toggle (mirrors Create tab pattern) -->
                        <Border Background="#FF0B1220" BorderBrush="{StaticResource B.Line}" BorderThickness="1"
                                CornerRadius="8" Padding="14,10" Margin="0,6,0,10">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="🔌  PROXY:"
                                               Style="{StaticResource T.Label}"
                                               VerticalAlignment="Center" Margin="0,0,12,0" />

                                    <ToggleButton x:Name="LoginProxyToggle" Grid.Column="1"
                                                  Content="OFF"
                                                  Width="80"
                                                  Checked="OnLoginProxyToggleChanged"
                                                  Unchecked="OnLoginProxyToggleChanged"
                                                  ToolTip="Override the proxy for the Playwright browser that replays cookies." />

                                    <TextBlock x:Name="LoginProxyHint" Grid.Column="2"
                                               Margin="14,0,0,0"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource T.Mini}"
                                               Text="OFF → direct connection (your ISP).  ON → first alive proxy." />
                                </Grid>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="🌐 URL:"
                                               Style="{StaticResource T.Label}"
                                               VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <TextBox Grid.Column="1" x:Name="LoginTargetUrlBox"
                                             Style="{StaticResource S.TextBox}"
                                             FontFamily="{StaticResource F.Mono}"
                                             Text="https://www.accio.com/" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- account list (read from Accio's accounts/cookies/) -->
                        <TextBlock Style="{StaticResource T.Mini}" Margin="2,6,0,6">
                            Select rows, then VERIFY LOGIN  →  makes a HEAD request to accio.com/dashboard
                            with the saved cookies.  HTTP 200 = session valid.  302 → /login = expired.
                        </TextBlock>

                        <Grid Margin="0,4,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="68" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="☐"   Style="{StaticResource HeadText}" />
                            <TextBlock Grid.Column="1" Text="#"    Style="{StaticResource HeadText}" />
                            <TextBlock Grid.Column="2" Text="EMAIL" Style="{StaticResource HeadText}" />
                            <TextBlock Grid.Column="3" Text="COOKIES" Style="{StaticResource HeadText}" />
                            <TextBlock Grid.Column="4" Text="COOKIE FILE" Style="{StaticResource HeadText}" />
                            <TextBlock Grid.Column="5" Text="VERIFY" Style="{StaticResource HeadText}" />
                            <TextBlock Grid.Column="6" Text="LOGIN" Style="{StaticResource HeadText}" />
                            <TextBlock Grid.Column="7" Text="DELETE" Style="{StaticResource HeadText}" />
                            <TextBlock Grid.Column="8" Text="VIEW" Style="{StaticResource HeadText}" />
                            <TextBlock Grid.Column="9" Text="EXPORT" Style="{StaticResource HeadText}" />
                        </Grid>
                        <Rectangle Height="1" Fill="{StaticResource B.Line}" />

                        <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="LoginList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34" />
                                                <ColumnDefinition Width="40" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="68" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" IsChecked="{Binding Selected, Mode=TwoWay}"
                                                      Style="{StaticResource S.CheckBox}"
                                                      VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding IdLabel}"
                                                       FontFamily="{StaticResource F.Mono}" FontSize="12"
                                                       Foreground="{StaticResource B.TextDim}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding EmailUsed}"
                                                       FontFamily="{StaticResource F.Mono}" FontSize="12"
                                                       Foreground="{StaticResource B.Text}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{Binding CookieLabel}"
                                                       FontSize="11.5"
                                                       Foreground="{StaticResource B.TextDim}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="4" Text="{Binding CookieFileLabel}"
                                                       FontFamily="{StaticResource F.Mono}" FontSize="10.5"
                                                       Foreground="{StaticResource B.TextMuted}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="5" Text="{Binding LastVerify}"
                                                       FontFamily="Segoe UI Semibold" FontSize="11"
                                                       Foreground="{Binding LastVerifyColor}"
                                                       VerticalAlignment="Center" />
                                            <Button Grid.Column="6" Content="🔑 Login"
                                                    Style="{StaticResource S.GhostButton}"
                                                    Height="28" FontSize="11" Margin="0,0,4,0"
                                                    Click="OnLoginOne" />
                                            <Button Grid.Column="7" Content="🗑 Delete"
                                                    Style="{StaticResource S.GhostButton}"
                                                    Height="28" FontSize="11" Margin="4,0,4,0"
                                                    Click="OnDeleteAccount" />
                                            <Button Grid.Column="8" Content="View"
                                                    Style="{StaticResource S.GhostButton}"
                                                    Height="28" FontSize="11" Margin="4,0,4,0"
                                                    Click="OnViewCookie" />
                                            <Button Grid.Column="9" Content="Export"
                                                    Style="{StaticResource S.GhostButton}"
                                                    Height="28" FontSize="11" Margin="4,0,0,0"
                                                    Click="OnExportCookie" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock x:Name="LoginHint" Style="{StaticResource T.Mini}" Margin="2,10,0,0">
                            Tip: accounts are loaded live from Accio's accounts/cookies/ folder.
                            Click VERIFY LOGIN to test each cookie set against accio.com.
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- ============== TAB: SETTINGS (alice.json live read) ============== -->
                <Border x:Name="TabSettings" Style="{StaticResource S.Card}" Margin="0,0,0,16" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="ACCIO SETTINGS  (mail read from Global Settings, all of it read-only here)" Style="{StaticResource T.Section}" />
                        <Rectangle Style="{StaticResource S.Rule}" />

                        <!-- ===== MAIL: per-tool ban list. Same control every other
                             tool panel has. Saves the moment you click; never
                             touches Global Settings. ===== -->
                        <TextBlock Style="{StaticResource T.Label}" Margin="0,0,0,6">
                            📬 MAIL  (ban a Gmail for THIS tool only)
                        </TextBlock>
                        <TextBlock x:Name="MailBanNote" Style="{StaticResource T.Mini}" Margin="2,0,0,8"
                                   TextWrapping="Wrap" Foreground="{StaticResource B.TextMuted}"
                                   Text="Choose which Gmail from Global Settings this tool may use. A BANNED Gmail is simply skipped for THIS tool — the remaining Gmails keep rotating. Your Global Settings (Method 2) is never changed, so every other tool keeps using it normally." />
                        <Border Background="#FF0B1220" BorderBrush="{StaticResource B.Line}" BorderThickness="1"
                                CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="190" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="GMAIL"              Style="{StaticResource HeadText}" />
                                    <TextBlock Grid.Column="1" Text="STATUS (this tool)" Style="{StaticResource HeadText}" />
                                    <TextBlock Grid.Column="2" Text="ACTION"             Style="{StaticResource HeadText}" />
                                </Grid>
                                <Rectangle Height="1" Fill="{StaticResource B.Line}" />
                                <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                                    <ItemsControl x:Name="MailList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="150" />
                                                        <ColumnDefinition Width="190" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Email}"
                                                               FontFamily="{StaticResource F.Mono}" FontSize="12"
                                                               Foreground="{StaticResource B.Text}"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding StatusLabel}"
                                                               FontSize="11.5" FontFamily="Segoe UI Semibold"
                                                               Foreground="{Binding StatusColor}" VerticalAlignment="Center" />
                                                    <Button Grid.Column="2" Content="{Binding ActionLabel}"
                                                            Style="{StaticResource S.GhostButton}"
                                                            Height="30" FontSize="11.5" MinWidth="160"
                                                            HorizontalAlignment="Left"
                                                            AutomationProperties.AutomationId="MailToggleBtn"
                                                            Click="OnMailToggle" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <TextBlock x:Name="MailBanEmpty" Style="{StaticResource T.Mini}" Margin="2,6,0,0"
                                           Foreground="{StaticResource B.TextMuted}" Visibility="Collapsed"
                                           Text="No Gmails configured in Global Settings → Method 2. Add one there first." />
                                <TextBlock x:Name="MailBanAllBanned" Style="{StaticResource T.Mini}" Margin="2,8,0,0"
                                           Foreground="#FFF87171" TextWrapping="Wrap" Visibility="Collapsed"
                                           Text="⚠ Every Gmail is BANNED for this tool — nothing can be picked. Add one back here to keep creating accounts." />
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource T.Label}" Margin="0,14,0,6">🔑 Gmail Pool credentials  (from Global Settings → Method 2)</TextBlock>
                        <Border Background="#FF06080C" BorderBrush="{StaticResource B.Line}" BorderThickness="1"
                                CornerRadius="8" Padding="12,8" MaxHeight="180">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="PoolList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="100" />
                                                    <ColumnDefinition Width="60" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Email}"
                                                           FontFamily="{StaticResource F.Mono}" FontSize="12"
                                                           Foreground="{StaticResource B.Text}" />
                                                <TextBlock Grid.Column="1" Text="{Binding UsedLabel}"
                                                           FontSize="11.5" Foreground="{StaticResource B.TextDim}" />
                                                <TextBlock Grid.Column="2" Text="{Binding StatusLabel}"
                                                           FontSize="11.5" FontFamily="Segoe UI Semibold"
                                                           Foreground="{Binding StatusColor}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <TextBlock Style="{StaticResource T.Label}" Margin="0,18,0,6">🌐 Custom Domain  (Global Settings → Method 3)</TextBlock>
                        <Border Background="#FF06080C" BorderBrush="{StaticResource B.Line}" BorderThickness="1"
                                CornerRadius="8" Padding="12,8" MaxHeight="120">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="DomainList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="60" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Domain}"
                                                           FontFamily="{StaticResource F.Mono}" FontSize="12"
                                                           Foreground="{StaticResource B.Text}" />
                                                <TextBlock Grid.Column="1" Text="{Binding UsageLabel}"
                                                           FontSize="11.5" Foreground="{StaticResource B.TextDim}" />
                                                <TextBlock Grid.Column="2" Text="{Binding ActiveLabel}"
                                                           FontSize="11.5" FontFamily="Segoe UI Semibold"
                                                           Foreground="{Binding ActiveColor}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <TextBlock Style="{StaticResource T.Label}" Margin="0,18,0,6">📥 Catch-all Inbox  (Global Settings → Method 3)</TextBlock>
                        <Border Background="#FF06080C" BorderBrush="{StaticResource B.Line}" BorderThickness="1"
                                CornerRadius="8" Padding="12,8">
                            <TextBlock x:Name="InboxLine" FontFamily="{StaticResource F.Mono}" FontSize="12"
                                       Foreground="{StaticResource B.Text}"
                                       TextWrapping="Wrap" />
                        </Border>

                        <Button x:Name="RefreshSettingsBtn" Content="🔄  REFRESH FROM DISK"
                                Style="{StaticResource S.GhostButton}"
                                HorizontalAlignment="Left"
                                Margin="0,18,0,0"
                                Click="OnRefreshSettings" />

                        <!-- ============== PROXY SETUP ============== -->
                        <TextBlock Text="🌐 PROXY SETUP  (writes to .env, no other Accio files touched)"
                                   Style="{StaticResource T.Label}"
                                   Margin="0,24,0,8" />

                        <TextBlock Style="{StaticResource T.Mini}" Margin="0,0,0,10">
                            Accio auto-fetches 20 fresh proxies per run when one of these is set.
                            If your provider's URL has a count parameter, replace the count value with n
                            (Accio fills in 20 automatically).
                        </TextBlock>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Single API URL :"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource T.Label}" Margin="0,0,0,8" />
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="ProxyApiBox"
                                     Style="{StaticResource S.TextBox}"
                                     FontFamily="{StaticResource F.Mono}"
                                     Margin="0,0,0,8" />
                            <Button Grid.Row="0" Grid.Column="2" x:Name="SaveProxyApiBtn"
                                    Content="💾  SAVE"
                                    Style="{StaticResource S.GhostButton}"
                                    Width="120" Margin="8,0,0,8"
                                    Click="OnSaveProxyApi" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Plain list URL(s) :"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource T.Label}" />
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="ProxySourcesBox"
                                     Style="{StaticResource S.TextBox}"
                                     FontFamily="{StaticResource F.Mono}"
                                     Margin="0,0,0,0" />
                            <Button Grid.Row="1" Grid.Column="2" x:Name="SaveProxySourcesBtn"
                                    Content="💾  SAVE"
                                    Style="{StaticResource S.GhostButton}"
                                    Width="120" Margin="8,0,0,0"
                                    Click="OnSaveProxySources" />
                        </Grid>

                        <TextBlock x:Name="ProxySetupStatus" Style="{StaticResource T.Mini}"
                                   Margin="0,10,0,0" />


                        <!-- ============== CONNECTION TEST ============== -->
                        <Rectangle Style="{StaticResource S.Rule}" Margin="0,24,0,18" />
                        <TextBlock Text="🔍 CONNECTION TEST  (no real signup, just diagnostic probes)"
                                   Style="{StaticResource T.Section}" />

                        <Button x:Name="ConnTestBtn" Content="▶  RUN CONNECTION TEST"
                                Style="{StaticResource S.PrimaryButton}"
                                Width="240"
                                HorizontalAlignment="Left"
                                Margin="0,12,0,12"
                                Click="OnConnectionTest" />

                        <Border x:Name="ConnTestPanel" Visibility="Collapsed"
                                Background="#FF06080C" BorderBrush="{StaticResource B.Line}" BorderThickness="1"
                                CornerRadius="8" Padding="14,12">
                            <StackPanel>
                                <ItemsControl x:Name="ConnTestList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="60" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Status}"
                                                           FontFamily="Segoe UI Semibold" FontSize="11"
                                                           Foreground="{Binding StatusColor}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Message}"
                                                           FontFamily="{StaticResource F.Mono}" FontSize="11.5"
                                                           Foreground="{StaticResource B.Text}"
                                                           TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="ConnTestVerdict" Margin="0,10,0,0"
                                           FontFamily="Segoe UI Semibold" FontSize="12"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ============== ACTIVITY LOG (always visible at bottom) ============== -->
                <Border Style="{StaticResource S.Card}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="ACTIVITY LOG" Style="{StaticResource T.Section}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="CLEAR" Style="{StaticResource S.GhostButton}"
                                        Height="28" FontSize="11"
                                        Click="OnClearLog" />
                                <Button Content="🖹  COPY LOG" Style="{StaticResource S.GhostButton}"
                                        Height="28" FontSize="11"
                                        Margin="8,0,0,0" Click="OnCopyLog" />
                            </StackPanel>
                        </Grid>
                        <Rectangle Style="{StaticResource S.Rule}" />

                        <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="LogList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="74" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Time}"
                                                       FontFamily="{StaticResource F.Mono}" FontSize="11"
                                                       Foreground="{StaticResource B.TextDim}" />
                                            <TextBlock Grid.Column="1" Text="{Binding KindLabel}"
                                                       FontFamily="Segoe UI Semibold" FontSize="10.5"
                                                       Foreground="{Binding KindColor}" />
                                            <TextBlock Grid.Column="2" Text="{Binding Message}"
                                                           FontFamily="{StaticResource F.Mono}" FontSize="11.5"
                                                           Foreground="{StaticResource B.Text}"
                                                           TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>