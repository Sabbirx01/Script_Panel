<Project Sdk="Microsoft.NET.Sdk">

  <!--
    DeveloperXPanel-Setup.exe

    ONE file the customer keeps. It carries the whole panel (exe + tools +
    runtime + .playwright) packed inside it, unpacks once into
    %LOCALAPPDATA%\DeveloperXPanel and then starts the panel from there.

    The payload is embedded, not copied beside the exe, so the customer never
    sees a folder - that is the whole point of this project.

    Building it:
        ..\temp\build-launcher.ps1            (zips the bundle, then builds this)

    Note for maintainers: XML comments may not contain a double hyphen, so
    keep decorative dash rules out of this file.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <AssemblyName>DeveloperXPanel-Setup</AssemblyName>
    <RootNamespace>LaunchPanel</RootNamespace>
    <Version>1.1.2</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!--
      Filled by build-launcher.ps1. The panel travels AES-256 encrypted; the
      version marker stays a separate tiny resource so the "already installed"
      path never has to decrypt 549 MB just to read a version number.

      PayloadKey.g.cs (the obfuscated AES key) is generated too - it is not
      listed here because the SDK already compiles every .cs in the folder.
    -->
    <PayloadEnc     Condition="'$(PayloadEnc)' == ''">payload\payload.enc</PayloadEnc>
    <PayloadVersion Condition="'$(PayloadVersion)' == ''">payload\bundle-version.txt</PayloadVersion>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(PayloadEnc)" LogicalName="payload.enc" Condition="Exists('$(PayloadEnc)')" />
    <EmbeddedResource Include="$(PayloadVersion)" LogicalName="bundle-version.txt" Condition="Exists('$(PayloadVersion)')" />
  </ItemGroup>

  <!-- Publishing without a payload would silently produce a useless exe. -->
  <Target Name="RequirePayload" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(PayloadEnc)')"
           Text="Payload missing: $(PayloadEnc). Run temp\build-launcher.ps1 instead of building this project directly." />
    <Error Condition="!Exists('$(PayloadVersion)')"
           Text="Version marker missing: $(PayloadVersion). Run temp\build-launcher.ps1." />
    <Error Condition="!Exists('PayloadKey.g.cs')"
           Text="PayloadKey.g.cs is missing. It holds the payload key and is generated by temp\build-launcher.ps1." />
  </Target>

</Project>
